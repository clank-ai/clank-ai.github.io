---
/** A block of commands to type, with the shell they go in and a button that copies them all. */
interface Props {
  lines: string[];
  shell?: string;
  label: string;
}
const { lines, shell = 'PowerShell', label } = Astro.props;
const text = lines.join('\n');
---

<div class="cmd-block" data-cmd-block>
  <div class="bar">
    <span class="shell">{shell}</span>
    <button type="button" class="copy" data-copy={text} aria-label={`Copy: ${label}`}>
      <span class="copy-label">Copy</span>
    </button>
  </div>
  <pre><code>{lines.map((l) => <span class="ln"><span class="p" aria-hidden="true">{shell === 'PowerShell' ? 'PS>' : '$'}</span>{l}</span>)}</code></pre>
  <p class="status sr-only" role="status" aria-live="polite"></p>
</div>

<script>
  for (const block of document.querySelectorAll<HTMLElement>('[data-cmd-block]')) {
    const button = block.querySelector<HTMLButtonElement>('.copy');
    const label = block.querySelector<HTMLElement>('.copy-label');
    const status = block.querySelector<HTMLElement>('.status');
    let timer = 0;
    button?.addEventListener('click', async () => {
      let copied = false;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        copied = true;
      } catch {
        // No clipboard here: select the commands so they can be copied by hand.
        const code = block.querySelector('code');
        const selection = window.getSelection();
        if (code && selection) {
          const range = document.createRange();
          range.selectNodeContents(code);
          selection.removeAllRanges();
          selection.addRange(range);
        }
      }
      if (label) label.textContent = copied ? 'Copied' : 'Selected';
      if (status) status.textContent = copied ? 'Commands copied.' : 'Commands selected: copy them with your keyboard.';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = 'Copy';
      }, 2200);
    });
  }
</script>

<style>
  .cmd-block {
    min-width: 0;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--well);
    overflow: hidden;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 6px 6px 14px;
    border-bottom: 1px solid var(--line);
    background: #111118;
  }

  .shell {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .copy {
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    background: var(--surface-2);
    color: var(--text-strong);
    font: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
  }

  .copy:hover {
    border-color: var(--muted);
  }

  pre {
    margin: 0;
    padding: 12px 16px;
    font-size: 0.88rem;
    line-height: 1.75;
    color: var(--text-strong);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ln {
    display: block;
    padding-left: 3.2em;
    text-indent: -3.2em;
  }

  .p {
    display: inline-block;
    width: 3.2em;
    text-indent: 0;
    color: var(--green);
    user-select: none;
  }
</style>
