---
/**
 * A real screenshot of Clank, captured from the running program (not drawn): optimized and sized to its box, itself a
 * link to the whole image, so a phone can open it and zoom; what it shows said in words (`alt`), and when and how it
 * was captured under it (`note`).
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  note?: string;
}
const { src, alt, note } = Astro.props;
const whole = await getImage({ src, format: 'webp', width: src.width });
---

<figure class="shot">
  <a class="shot-link" href={whole.src} aria-label={`${alt} The whole image.`}>
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280, Math.min(1920, src.width)].filter((w, k, all) => all.indexOf(w) === k)}
      sizes="(min-width: 1180px) 680px, 92vw"
      loading="lazy"
      decoding="async"
    />
  </a>
  {note && (
    <figcaption>
      {note}<span class="zoom"> Tap it to see it whole.</span>
    </figcaption>
  )}
</figure>

<style>
  .shot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .shot-link {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #343a55;
    box-shadow: 0 30px 70px -40px rgba(0, 0, 0, 0.9);
  }

  .shot-link :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .zoom {
    display: none;
  }

  @media (max-width: 700px) {
    .zoom {
      display: inline;
    }
  }
</style>
