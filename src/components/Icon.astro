---
/** The few icons the site uses, drawn inline (no icon font, no requests). Decorative unless a label is given. */
interface Props {
  name: 'github' | 'arrow' | 'copy' | 'check' | 'pause' | 'play';
  size?: number;
  label?: string;
}
const { name, size = 18, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

{
  name === 'github' && (
    <svg width={size} height={size} viewBox="0 0 16 16" focusable="false" {...a11y}>
      <path
        fill="currentColor"
        d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
      />
    </svg>
  )
}
{
  name === 'arrow' && (
    <svg width={size} height={size} viewBox="0 0 20 20" focusable="false" {...a11y}>
      <path d="M4 10h11M11 5.5 15.5 10 11 14.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'copy' && (
    <svg width={size} height={size} viewBox="0 0 20 20" focusable="false" {...a11y}>
      <rect x="6.5" y="6.5" width="10" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M13.5 6.5V5a1.5 1.5 0 0 0-1.5-1.5H5A1.5 1.5 0 0 0 3.5 5v7A1.5 1.5 0 0 0 5 13.5h1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
    </svg>
  )
}
{
  name === 'check' && (
    <svg width={size} height={size} viewBox="0 0 20 20" focusable="false" {...a11y}>
      <path d="m4.5 10.5 3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'pause' && (
    <svg width={size} height={size} viewBox="0 0 20 20" focusable="false" {...a11y}>
      <path d="M7 5v10M13 5v10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'play' && (
    <svg width={size} height={size} viewBox="0 0 20 20" focusable="false" {...a11y}>
      <path d="M7 5.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L7.9 4.7a.6.6 0 0 0-.9.5Z" fill="currentColor" />
    </svg>
  )
}
