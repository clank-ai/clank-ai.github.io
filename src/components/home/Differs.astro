---
/**
 * Home: how Clank differs from a hosted agent, in brief. The Why page compares them problem by
 * problem; here, three lines and the link to it. Hosted agents are named only as examples.
 */
import { PAGES } from '../../config';

const points = [
  ['The model', 'yours to choose, and to run on your GPU or through your key'],
  ['Your work', 'on your computer; the cloud only after your yes, per workspace'],
  ['Every request', 'recorded, with its tokens and its cost'],
];
---

<section class="section" id="differs" aria-labelledby="differs-title">
  <div class="container">
    <div class="differs">
      <div class="text">
        <p class="eyebrow">Clank and hosted agents</p>
        <h2 id="differs-title">Built for control, and for independence.</h2>
        <p class="lead">
          A hosted agent such as Codex or Claude Code runs on its provider's models and servers: a quick way to start.
          Clank is for when you want the model, the machine and the record in your own hands.
        </p>
        <a class="more" href={PAGES.why.path}>Why Clank, problem by problem</a>
      </div>
      <ul class="points">
        {
          points.map(([t, d]) => (
            <li>
              <b>{t}</b>
              <span>{d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .differs {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 4.5vw, 64px);
    align-items: center;
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  h2 {
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .lead {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--muted);
  }

  .points {
    list-style: none;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .points li {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 16px;
    padding: 18px 22px;
    align-items: baseline;
  }

  .points li + li {
    border-top: 1px solid var(--line);
  }

  .points b {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .points span {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .differs {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .points li {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
