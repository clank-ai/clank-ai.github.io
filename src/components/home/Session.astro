---
/** Home: what you do with Clank, as a normal session in four numbered steps, each with the screen it shows. */
import Window from '../Window.astro';
import Crop from '../Crop.astro';
import { agentAtWork, folder, miniFlow, session } from '../../scripts/crops';
import { PAGES } from '../../config';

const steps = [
  {
    t: 'Open a folder',
    d: 'Type <code>clank</code> in a project folder. <b>This folder</b> lists what working there needs, and <kbd>g</kbd> does each step not done yet: Docker, the folder\'s workspace, the model, the gateway.',
    shot: 'clank · This folder · F4',
    crop: folder(),
    label: 'This folder: each step working here needs, a check for each one done, then the keys to start the agent.',
  },
  {
    t: 'Ask the agent',
    d: '<kbd>a</kbd> starts OpenCode in the terminal, or <kbd>c</kbd> opens the folder in VS Code with the agent at its side. Say what you want in your own words; it reads, writes and runs commands in its sandbox, and asks before it changes a file.',
    shot: 'opencode · in the workspace',
    crop: agentAtWork(),
    label: 'OpenCode at work: the request, then the files it reads and the one it writes.',
  },
  {
    t: 'Watch it, and steer',
    d: '<kbd>F10</kbd> opens the <b>Monitor</b>: what fills the context window, what the agent does this second, and the Guide to stop, note, pause, compact, undo or drop, each priced before you confirm.',
    shot: 'clank · the Monitor · F10',
    crop: session(),
    label: "The Monitor's Session view: the context window by part, what the session does now, and the Guide's keys.",
  },
  {
    t: 'Bigger work, as a flow',
    d: '<kbd>f</kbd> plans it with the model, as boxes. <kbd>r</kbd> runs them, each a fresh session; a check sends a plan back with findings; it stops at the end for your review.',
    shot: 'clank · the Monitor · Flow view',
    crop: miniFlow({ plan: 'done', verify: 'done', tasks: 'run' }),
    label: 'A flow running: PLAN and VERIFY done, the tasks running, INTEGRATE and your GATE still to come.',
  },
];
---

<section class="section" id="session" aria-labelledby="session-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">A session</p>
      <h2 id="session-title">What you do with it.</h2>
      <p class="lead">
        A normal session, from a folder to the agent at work, with you watching. The screens are the console's own.
      </p>
    </div>
    <ol class="flow">
      {
        steps.map((s, i) => (
          <li>
            <div class="txt">
              <span class="n" aria-hidden="true">{i + 1}</span>
              <h3>{s.t}</h3>
              <p set:html={s.d} />
            </div>
            <Window title={s.shot}>
              <Crop crop={s.crop} label={s.label} max="12px" />
            </Window>
          </li>
        ))
      }
    </ol>
    <p class="after">
      <a class="more" href="#demo">Watch a flow built and run, step by step</a>
      <a class="more" href={PAGES.start.path}>Every step of getting started</a>
    </p>
  </div>
</section>

<style>
  .flow {
    margin-top: clamp(32px, 4vw, 48px);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    counter-reset: step;
  }

  .flow li {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    padding: clamp(18px, 2.2vw, 26px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .txt {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 6px 14px;
    align-items: center;
  }

  .n {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--orange);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }

  h3 {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .txt p {
    grid-column: 2;
    color: var(--muted);
  }

  .txt :global(code),
  .txt :global(kbd) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 0.06em 0.4em;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-strong);
    white-space: nowrap;
  }

  .txt :global(kbd) {
    border-bottom-width: 2px;
  }

  .txt :global(b) {
    color: var(--text-strong);
    font-weight: 600;
  }

  .after {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  @media (max-width: 860px) {
    .flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .txt p {
      grid-column: 1 / -1;
    }
  }
</style>
