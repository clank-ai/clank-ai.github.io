---
/**
 * Home's story: why Clank exists, in brief. Two aims, held to equally, each point leading to the
 * feature that does it. The Why Clank page says it in full.
 */
import { PAGES } from '../../config';

const f = PAGES.features.path;
const control = [
  ['Every setting visible, and yours', 'engine, model file, window, output, thinking, sampling, margins and limits, in readable files', `${f}#models`],
  ['Every request recorded', 'its model, its tokens and its cost, kept on your computer', `${f}#gateway`],
  ['The context window, part by part', 'what fills it, how it grew, what you could free, live', `${f}#context`],
  ['The agent, watched and steered', 'stop, note, pause, compact, undo or drop, each priced first', `${f}#monitor`],
  ['Long work as flows', 'fresh, prepared sessions, each checked, you at the final review', `${f}#flows`],
];
const independence = [
  ['Local models, no usage limits', 'an open model on your GPU: no quota, nothing to pay per request', `${f}#models`],
  ['The cloud when you choose', 'your own key, per workspace, after your yes, with spending limits', `${f}#cloud`],
  ['A model per task', 'plan on one model, run the tasks on another, local or cloud', `${f}#flows`],
  ['Your work on your machine', 'files, conversations, keys and records stay with you', `${f}#privacy`],
  ['Open all the way down', 'Clank is open source, and so is OpenCode, the agent it runs', PAGES.openSource.path],
];
---

<section class="section" id="purpose" aria-labelledby="purpose-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Why Clank</p>
      <h2 id="purpose-title">Built for control, and for independence.</h2>
      <p class="lead">
        Clank exists so you control the models behind your coding agents with far higher precision, and so you depend
        dramatically less on cloud providers and hosted agents such as Codex and Claude Code. Its aim is to be far more
        useful to you than those tools.
      </p>
    </div>
    <div class="aims">
      <article class="aim control">
        <p class="k">Precise control</p>
        <h3>The models behind your agents, in your hands.</h3>
        <ul>
          {
            control.map(([t, d, href]) => (
              <li>
                <a href={href}>
                  <b>{t}</b>
                  <span>{d}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="aim free">
        <p class="k">Less dependence</p>
        <h3>A hosted agent becomes one option among several.</h3>
        <ul>
          {
            independence.map(([t, d, href]) => (
              <li>
                <a href={href}>
                  <b>{t}</b>
                  <span>{d}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
    <p class="after"><a class="more" href={PAGES.why.path}>Why Clank, in full</a></p>
  </div>
</section>

<style>
  .aims {
    margin-top: clamp(32px, 4vw, 48px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .aim {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(22px, 2.6vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(80% 60% at 0% 0%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 70%),
      var(--surface);
  }

  .control {
    --accent: var(--orange);
  }

  .free {
    --accent: var(--teal);
  }

  .k {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h3 {
    font-size: 1.35rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  ul {
    margin-top: 6px;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  li a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 12px;
    padding: 12px 0;
    color: var(--muted);
    text-decoration: none;
  }

  li a::after {
    content: '→';
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    color: var(--faint);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  li a:hover::after {
    color: var(--blue);
    transform: translateX(3px);
  }

  li b {
    color: var(--text-strong);
    font-weight: 600;
  }

  li span {
    grid-column: 1;
    font-size: 0.95rem;
  }

  .after {
    margin-top: 16px;
  }

  @media (max-width: 860px) {
    .aims {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
