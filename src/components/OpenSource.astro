---
/** The repository: how Clank is written to be read, and where its documents, code and tests live. */


const tree = [
  { path: 'docs/PRINCIPLES.md', note: 'why Clank exists, and its rules', depth: 1 },
  { path: 'docs/design/', note: 'each part designed before its code', depth: 1 },
  { path: 'docs/decisions/', note: 'every choice, with its reasons', depth: 1 },
  { path: 'docs/plans/', note: 'each step, task by task', depth: 1 },
  { path: 'docs/CODEMAP.md', note: 'one line per module', depth: 1, last: true },
  { path: 'clank/', note: 'the service, the gateway, the console', depth: 0 },
  { path: 'tests/', note: 'each names the design it holds to', depth: 0 },
];
---

<section class="section" id="open-source" aria-labelledby="oss-title">
  <div class="container oss">
    <div class="oss-text">
      <p class="eyebrow">The repository</p>
      <h2 id="oss-title">Written to be read, by people and by models.</h2>
      <p class="lead">
        Every part is designed before it is built, and every decision is recorded with its reasons. Each module begins
        by saying what it does and why, so your own local model can find its way and help you change Clank.
      </p>
      <ul class="facts">
        <li>Settings in readable files, never hidden in code</li>
        <li>A test for every behavior, named for what it proves</li>
        <li>Small steps, each one a commit that says why</li>
      </ul>
    </div>

    <figure class="tree" aria-label="Part of Clank's repository: its documents, its code and its tests">
      <p class="tree-name">clank</p>
      <ul>
        <li class="d0"><span class="p">docs/</span></li>
        {
          tree.map((t) => (
            <li class={`d${t.depth}${t.last ? ' last' : ''}`}>
              <span class="p">{t.depth === 1 ? t.path.replace('docs/', '') : t.path}</span>
              <span class="c">{t.note}</span>
            </li>
          ))
        }
      </ul>
    </figure>
  </div>
</section>

<style>
  .oss {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .oss-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }

  h2 {
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .lead {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--muted);
  }

  .facts {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .facts li {
    display: flex;
    gap: 12px;
    align-items: baseline;
  }

  .facts li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    transform: translateY(-2px) rotate(45deg);
    background: var(--green);
  }



  .tree {
    margin: 0;
    padding: clamp(20px, 2.4vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--well);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .tree-name {
    color: var(--orange);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .tree ul {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .tree li {
    position: relative;
    display: grid;
    --indent: 0px;
    grid-template-columns: calc(16ch - var(--indent)) minmax(0, 1fr);
    gap: 2px 16px;
    padding: 5px 0 5px 22px;
  }

  .tree li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--line-strong);
  }

  .tree li::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 15px;
    width: 12px;
    border-top: 1px solid var(--line-strong);
  }

  .tree li.d1 {
    --indent: 22px;
    padding-left: 44px;
  }

  .tree li.d1::after {
    left: 26px;
  }

  .tree li.d1 {
    background: linear-gradient(var(--line-strong), var(--line-strong)) no-repeat 26px 0 / 1px 100%;
  }

  .tree li.d1.last {
    background-size: 1px 15px;
  }

  .tree li:last-child::before {
    bottom: calc(100% - 15px);
  }

  .p {
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }

  .c {
    color: var(--faint);
  }

  @media (max-width: 900px) {
    .oss {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 460px) {
    .tree li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
