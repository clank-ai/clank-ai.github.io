---
/** The top of an inner page: where it sits, its name, and what it covers. */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  crumb: string;
  eyebrow: string;
  title: string;
  lead: string;
}
const { crumb, eyebrow, title, lead } = Astro.props;
---

<header class="page-head">
  <div class="glow" aria-hidden="true"></div>
  <div class="container inner">
    <Breadcrumbs items={[{ label: crumb }]} />
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <slot />
  </div>
</header>

<style>
  .page-head {
    position: relative;
    isolation: isolate;
    padding-block: clamp(40px, 6vw, 72px) clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 90% at 15% 0%, rgba(122, 162, 247, 0.09), transparent 70%),
      linear-gradient(to right, rgba(122, 162, 247, 0.05) 1px, transparent 1px) 0 0 / 36px 72px,
      linear-gradient(to bottom, rgba(122, 162, 247, 0.05) 1px, transparent 1px) 0 0 / 36px 72px;
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent);
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .eyebrow {
    margin-top: 18px;
  }

  h1 {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 18em;
  }

  .lead {
    max-width: 42rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--muted);
  }
</style>
