---
/**
 * A way back to the top, shown once the page has scrolled a screen or so, and only where it covers
 * nothing: in the margin of a wide window, and never over the demo, which is wider than the text.
 */
---

<a class="top" href="#top-of-page" data-totop hidden aria-label="Back to the top">
  <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 15V5M5.5 9.5 10 5l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</a>

<script>
  const button = document.querySelector<HTMLElement>('[data-totop]');
  if (button) {
    const wide = window.matchMedia('(min-width: 1360px)');
    let overDemo = false;
    const show = () => (button.hidden = window.scrollY < 900 || !wide.matches || overDemo);
    const demo = document.querySelector('[data-split-demo]');
    if (demo) {
      new IntersectionObserver((entries) => {
        overDemo = entries.some((e) => e.isIntersecting);
        show();
      }).observe(demo);
    }
    window.addEventListener('scroll', show, { passive: true });
    wide.addEventListener('change', show);
    show();
  }
</script>

<style>
  .top {
    position: fixed;
    right: max(18px, env(safe-area-inset-right, 0px));
    bottom: max(18px, env(safe-area-inset-bottom, 0px));
    z-index: 45;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: rgba(31, 33, 51, 0.92);
    color: var(--text-strong);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.6);
  }

  .top[hidden] {
    display: none;
  }

  .top:hover {
    border-color: var(--muted);
    color: var(--text-strong);
  }
</style>
