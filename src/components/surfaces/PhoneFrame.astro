---
/**
 * The iPhone app, coming: its Now screen, from the phone design canvas, with example names.
 * What runs, the machine, and what waits for you, answered with a tap.
 */
---

<div class="phone" role="img" aria-label="Clank's iPhone app, coming: the Now screen shows the model at work on a flow's box, the machine's load, and two questions waiting: OpenCode asks to edit NOTES.md, and Clank asks whether my-api may use the cloud.">
  <div class="screen" aria-hidden="true">
    <div class="island"></div>
    <div class="hdr">
      <b>◆ CLANK</b><span class="host">my-pc</span><span class="live"><i></i>live</span>
    </div>
    <div class="now">
      <p class="l1"><b>your-model</b><span>local</span></p>
      <p class="l2"><span class="p">writing</span><span>T2 · rate-limits</span><span class="mu">step 14</span></p>
      <p class="meter"><span class="mu">window</span><span class="bar"><i style="width: 18%"></i></span><span>24K / 131K</span></p>
    </div>
    <div class="machine">
      <p><span class="mu">GPU</span><span class="bar"><i class="o" style="width: 88%"></i></span></p>
      <p><span class="mu">VRAM</span><span class="bar"><i class="o" style="width: 81%"></i></span></p>
      <p><span class="mu">CPU</span><span class="bar"><i style="width: 18%"></i></span></p>
      <p><span class="mu">RAM</span><span class="bar"><i style="width: 46%"></i></span></p>
    </div>
    <p class="sect"><span>Waiting for you</span><b>2</b><i></i></p>
    <div class="card">
      <p class="who"><span class="y">◆ OpenCode asks: edit</span><span class="mu">3 min</span></p>
      <p class="file"><span>NOTES.md</span><span class="g">+6</span><span class="r">−2</span></p>
      <p class="btns"><b class="pri">Allow once</b><b>Always</b><b class="no">Reject</b></p>
    </div>
    <div class="card">
      <p class="who"><span class="y">◆ Clank asks</span><span class="mu">1 min</span></p>
      <p>Use the cloud in my-api?</p>
      <p class="btns"><b class="pri">Allow in my-api</b><b class="no">No</b></p>
    </div>
    <nav class="tabs">
      <span class="on">Now</span><span>Flows</span><span>Work</span><span>Files</span><span>More</span>
    </nav>
  </div>
</div>

<style>
  .phone {
    width: min(300px, 100%);
    aspect-ratio: 390 / 820;
    max-width: 100%;
    padding: 10px;
    border-radius: 46px;
    background: linear-gradient(145deg, #2b2f42, #15161e);
    box-shadow:
      inset 0 0 0 1.5px #3b4261,
      0 40px 90px -30px rgba(0, 0, 0, 0.9);
    container-type: inline-size;
  }

  .screen {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 2.6cqi;
    padding: 13cqi 4.5cqi 0;
    border-radius: 37px;
    background: #1a1b26;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 4.2cqi;
    line-height: 1.45;
    color: #c0caf5;
  }

  .island {
    position: absolute;
    top: 3.5cqi;
    left: 50%;
    width: 30%;
    height: 7.5cqi;
    border-radius: 99px;
    background: #050508;
    transform: translateX(-50%);
  }

  p {
    margin: 0;
  }

  .hdr {
    display: flex;
    align-items: center;
    gap: 3cqi;
    padding-bottom: 2.5cqi;
    border-bottom: 1px solid #3b4261;
  }

  .hdr b {
    color: #ff9e64;
  }

  .host {
    flex: 1;
    color: #9aa5ce;
  }

  .live {
    display: flex;
    align-items: center;
    gap: 1.5cqi;
    color: #9ece6a;
  }

  .live i {
    width: 2.2cqi;
    height: 2.2cqi;
    border-radius: 50%;
    background: #9ece6a;
  }

  .now p,
  .machine p,
  .who,
  .file {
    display: flex;
    align-items: center;
    gap: 2.5cqi;
  }

  .l1 span,
  .mu {
    color: #9aa5ce;
  }

  .l1 span {
    flex: 1;
  }

  .l2 span:nth-child(2) {
    flex: 1;
  }

  .p {
    color: #bb9af7;
  }

  .bar {
    flex: 1;
    height: 1.8cqi;
    border-radius: 99px;
    background: #292e42;
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    background: #7aa2f7;
  }

  .bar i.o {
    background: #ff9e64;
  }

  .meter span:first-child,
  .machine span:first-child {
    width: 8ch;
  }

  .machine {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5cqi 4cqi;
    padding-bottom: 2.5cqi;
    border-bottom: 1px solid #3b4261;
    font-size: 3.6cqi;
  }

  .machine span:first-child {
    width: 5ch;
  }

  .sect {
    display: flex;
    align-items: center;
    gap: 2cqi;
    color: #9aa5ce;
    font-size: 3.8cqi;
  }

  .sect b {
    color: #e0af68;
  }

  .sect i {
    flex: 1;
    border-top: 1px solid #3b4261;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1.5cqi;
    padding: 3cqi;
    border: 1px solid #e0af68;
    border-radius: 2.5cqi;
  }

  .who {
    justify-content: space-between;
    font-size: 3.8cqi;
  }

  .y {
    color: #e0af68;
  }

  .g {
    color: #9ece6a;
  }

  .r {
    color: #f7768e;
  }

  .file span:first-child {
    flex: 1;
  }

  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 2cqi;
    padding-top: 1cqi;
  }

  .btns b {
    padding: 1.6cqi 2.6cqi;
    border-radius: 1.6cqi;
    border: 1px solid #3b4261;
    background: #1f2335;
    font-weight: 400;
    font-size: 3.6cqi;
  }

  .btns .pri {
    border-color: #7aa2f7;
    background: #7aa2f7;
    color: #1a1b26;
    font-weight: 700;
  }

  .btns .no {
    border-color: #f7768e;
    background: transparent;
    color: #f7768e;
  }

  .tabs {
    margin-top: auto;
    display: flex;
    justify-content: space-around;
    padding: 3cqi 0 6cqi;
    border-top: 1px solid #3b4261;
    background: #16161e;
    margin-inline: -4.5cqi;
    font-size: 3.4cqi;
    color: #9aa5ce;
  }

  .tabs .on {
    color: #7aa2f7;
  }
</style>
