---
/**
 * The iPhone app as it is, in a phone's frame: the screenshots of clank-bench's captures/phone (copied by
 * scripts/sync-captures.py), the first three side by side, each with its caption; a phone shows the first. Until the
 * capture is copied, the sample stands in and says so, in development only: a build without the capture shows none.
 */
import { Image } from 'astro:assets';
import SampleTag from '../SampleTag.astro';
import { phoneFrames, shipped } from '../../data/captures';

const shown = phoneFrames.data.slice(0, 3);
---

{shipped(phoneFrames) && (
<figure class="shots">
  <ol class="row">
    {
      shown.map((frame, i) => (
        <li class:list={[i > 0 && 'extra']}>
          <div class="phone">
            <div class="glass">
              <Image
                src={frame.image}
                alt={frame.caption}
                widths={[Math.min(780, frame.image.width), frame.image.width].filter((w, k, all) => all.indexOf(w) === k)}
                sizes="(min-width: 960px) 200px, 260px"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
          <p class="cap">{frame.caption}</p>
        </li>
      ))
    }
  </ol>
  {phoneFrames.sample && <SampleTag source={phoneFrames.source} />}
</figure>
)}

<style>
  .shots {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    width: 100%;
  }

  .row li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .phone {
    width: 100%;
    max-width: 230px;
    aspect-ratio: 406 / 860;
    padding: 3.6%;
    border-radius: 13% / 6.2%;
    background: linear-gradient(150deg, #33384f, #15161e 60%);
    box-shadow:
      inset 0 0 0 1.5px #3b4261,
      0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .glass {
    height: 100%;
    border-radius: 11.5% / 5.4%;
    overflow: hidden;
    background: #16161e;
  }

  .glass :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .cap {
    max-width: 230px;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .row li.extra {
      display: none;
    }

    .phone {
      max-width: 260px;
    }
  }
</style>
