---
/** The Guide: the Monitor's keys for steering a session, what each does and what it costs. */
const guide = [
  ['.', 'Stop now', 'ends the step at once', 'nothing read again'],
  ['m', 'Note', 'a message, read at the next step', 'what a new message re-reads'],
  ['p', 'Pause', 'the gateway holds the next request', 'nothing while held'],
  ['u', 'Undo', 'reverts the last step; again redoes it', 'shown before you confirm'],
  ['k', 'Compact now', 'summarizes the history', 'one full reading of it'],
  ['x', 'Drop', 'clears one tool result', 'what came after it, read once'],
];
---

<div class="guide">
  <table>
    <caption class="sr-only">The Guide's actions</caption>
    <thead>
      <tr>
        <th scope="col">Key</th>
        <th scope="col">Action</th>
        <th scope="col">What it does</th>
        <th scope="col">What it costs</th>
      </tr>
    </thead>
    <tbody>
      {
        guide.map(([key, action, does, costs]) => (
          <tr>
            <td>
              <kbd class="key">{key}</kbd>
            </td>
            <th scope="row">{action}</th>
            <td>{does}</td>
            <td class="cost">{costs}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .guide {
    padding: 6px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
  }

  thead th {
    padding: 12px 12px 10px 0;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: left;
    color: var(--faint);
  }

  tbody th,
  tbody td {
    padding: 11px 12px 11px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: baseline;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  tbody th {
    color: var(--text-strong);
    font-weight: 600;
    white-space: nowrap;
  }

  tbody td {
    color: var(--muted);
  }

  td.cost {
    color: var(--text);
  }

  @media (max-width: 620px) {
    thead {
      display: none;
    }

    tbody tr {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2px 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }

    tbody tr:last-child {
      border-bottom: 0;
    }

    tbody th,
    tbody td {
      padding: 0;
      border: 0;
    }

    tbody td:first-child {
      grid-row: span 3;
    }

    tbody th {
      white-space: normal;
    }
  }
</style>
