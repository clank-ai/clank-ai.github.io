---
/**
 * The demo: one terminal window split in two, OpenCode on the left and Clank's console on the right,
 * as Clank opens them (the planning session beside the console), and beside it the walkthrough: the
 * six steps it is told in, the one playing, what happens now, and where to read it all.
 *
 * The panes are drawn by src/scripts/demo/ as monospace cells; that script also sizes the window to
 * the screen it is shown on (the cells' font and rows from the height and width there is), and picks
 * the layout: the walkthrough beside the window on a wide screen, under it otherwise, the panes one
 * above the other on a phone. The cells are hidden from screen readers; the walkthrough's text, and
 * every moment of it in a list of its own, are not.
 */
import Icon from '../Icon.astro';
import { CAPTIONS, CHAPTERS } from '../../scripts/demo/captions';
import { LINKS } from '../../config';

const flowDoc = `${LINKS.console}#building-a-flow-with-the-model-then-letting-it-run`;
---

<figure class="split-demo lay-split" data-split-demo data-layout="split" aria-labelledby="demo-title">
  <div class="frame" data-frame>
    <div class="panes" data-panes>
      <section class="pane-wrap oc" aria-label="OpenCode, the agent">
        <p class="pane-label">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <b>OpenCode</b><span class="x1">the agent</span><span class="x2">· planning session</span>
        </p>
        <div class="pane" data-pane="opencode" aria-hidden="true"></div>
      </section>
      <section class="pane-wrap ck" aria-label="Clank, the console">
        <p class="pane-label">
          <b>Clank</b><span class="x1">the console</span><span class="x2">· Monitor <kbd>F10</kbd> · Flow view</span>
          <span class="path">~/my-api</span>
        </p>
        <div class="pane" data-pane="clank" aria-hidden="true"></div>
      </section>
    </div>
  </div>

  <figcaption class="walk" data-walk>
    <div class="walk-head">
      <p class="walk-k">Walkthrough</p>
      <h2 id="demo-title" class="walk-title">Build a flow with the model, then run it</h2>
    </div>

    <div class="walk-ctl">
      <button type="button" class="toggle" data-toggle aria-label="Pause the walkthrough">
        <span class="i-pause"><Icon name="pause" size={16} /></span>
        <span class="i-play"><Icon name="play" size={16} /></span>
        <span data-toggle-label>Pause</span>
      </button>
      <p class="pos" data-pos>Step 1 of {CHAPTERS.length}</p>
    </div>

    <ol class="steps" aria-label="The steps: pick one to play it from there">
      {
        CHAPTERS.map((c, i) => (
          <li class:list={{ on: i === 0 }}>
            <button type="button" data-chapter={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="n" aria-hidden="true">{i + 1}</span>
              <span class="nm">{c.name}</span>
              <span class="what">{c.what}</span>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="now" data-now>
      <p class="now-k" data-now-k>Now · {CHAPTERS[0].name}</p>
      <p class="caption" data-caption>{CAPTIONS[0]}</p>
      <span class="prog" aria-hidden="true"><i data-prog></i></span>
    </div>

    <div class="walk-links">
      <a class="walk-cta" href={LINKS.walkthrough}>
        <span class="cta-t">Read the written walkthrough <Icon name="arrow" size={16} /></span>
        <span class="cta-d">Working with Clank in the docs, step by step, from setup to review.</span>
      </a>
      <a class="walk-alt" href={flowDoc}>This flow, key by key</a>
    </div>

    <div class="sr-only">
      <p>The walkthrough, moment by moment:</p>
      <ol>
        {CAPTIONS.map((c) => <li>{c}</li>)}
      </ol>
      <p>
        OpenCode, the open-source coding agent Clank runs, is shown as it appears in a terminal. The folder, the flow and
        the model are examples.
      </p>
    </div>
  </figcaption>
</figure>

<script>
  import '../../scripts/demo/demo';
</script>

<style>
  /*
   * The script sets --cell-fs (the cells' font size), the panes' widths and the layout, as a class:
   * lay-side (the walkthrough beside the window), lay-split (under it) or lay-stack (panes one above
   * the other). Classes, not an attribute: Chrome restyles the panel at once for a class it measures.
   * --lh is the cells' line height; the script reads it to size the window.
   */
  .split-demo {
    --cell-fs: 12px;
    --lh: 1.36;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .split-demo.lay-side {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    gap: 20px;
  }

  /* ---- The window ---- */

  .frame {
    position: relative;
    flex: none;
    min-width: 0;
    align-self: center;
    max-width: 100%;
    border-radius: 14px;
    border: 1px solid #343a55;
    background: #16161e;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 0 0 1px rgba(0, 0, 0, 0.4),
      0 50px 120px -40px rgba(0, 0, 0, 0.85),
      0 0 160px -60px rgba(122, 162, 247, 0.35);
    overflow: hidden;
    transition: opacity 0.4s ease;
  }

  .lay-stack .frame {
    align-self: stretch;
  }

  .lay-side .frame {
    align-self: flex-start;
  }

  .frame.restarting {
    opacity: 0.3;
  }

  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .pane-wrap {
    min-width: 0;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  :is(.lay-side, .lay-split) .pane-wrap.oc {
    border-right: 1px solid #272b3f;
  }

  .lay-stack .pane-wrap.oc {
    border-bottom: 1px solid #272b3f;
  }

  .pane-wrap.oc {
    background: #13131a;
  }

  .pane-wrap.ck {
    background: #1a1b26;
  }

  /* One line, always the same height: what does not fit is left out (the container queries below). */
  .pane-label {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 12px;
    border-bottom: 1px solid #22263a;
    background: #111118;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
    white-space: nowrap;
  }

  .lights {
    display: flex;
    gap: 6px;
    margin-right: 4px;
  }

  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #33384f;
  }

  .pane-label b {
    letter-spacing: 0.04em;
  }

  .oc .pane-label b {
    color: var(--purple);
  }

  .ck .pane-label b {
    color: var(--orange);
  }

  .pane-label kbd {
    font: inherit;
    color: var(--blue);
  }

  .pane-label .path {
    margin-left: auto;
  }

  @container (max-width: 520px) {
    .ck .pane-label .x2 {
      display: none;
    }
  }

  @container (max-width: 330px) {
    .oc .pane-label .x2,
    .ck .pane-label .path {
      display: none;
    }
  }

  @container (max-width: 210px) {
    .pane-label .x1,
    .lights {
      display: none;
    }
  }

  .pane {
    min-width: 0;
    padding: 8px;
    overflow: hidden;
  }

  /* The cells: every character one cell, the console's colors */
  .pane :global(.cells),
  .pane :global(.probe) {
    font-family: 'Clank Cells', 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace;
    font-size: var(--cell-fs);
    line-height: var(--lh);
    font-variant-ligatures: none;
    font-feature-settings: 'calt' 0, 'liga' 0;
  }

  .pane :global(.probe) {
    position: absolute;
    visibility: hidden;
    white-space: pre;
  }

  .pane :global(.cells) {
    margin: 0;
    color: #c0caf5;
    white-space: pre;
    overflow: hidden;
  }

  .pane :global(.cw) {
    display: inline-block;
    width: 1ch;
    font-style: normal;
    text-align: center;
    overflow: visible;
  }

  .pane :global(.mu) { color: #9aa5ce; }
  .pane :global(.ln) { color: #414868; }
  .pane :global(.hb) { color: #c0caf5; font-weight: 700; }
  .pane :global(.wb) { color: #e0e5ff; font-weight: 700; }
  .pane :global(.or) { color: #ff9e64; font-weight: 700; }
  .pane :global(.g) { color: #9ece6a; }
  .pane :global(.t) { color: #73daca; }
  .pane :global(.tb) { color: #73daca; font-weight: 700; }
  .pane :global(.y) { color: #e0af68; }
  .pane :global(.r) { color: #f7768e; }
  .pane :global(.b) { color: #7aa2f7; }
  .pane :global(.p) { color: #bb9af7; }
  .pane :global(.key) { color: #7aa2f7; font-weight: 700; }
  .pane :global(.kf) { color: #16161e; background: #e0af68; font-weight: 700; }
  .pane :global(.sel) { color: #e0e5ff; background: #283457; font-weight: 700; }
  .pane :global(.ut) { color: #e0e5ff; }
  .pane :global(.ib) { background: #1f2133; }
  .pane :global(.pb) { color: #bb9af7; background: #1f2133; }
  .pane :global(.ibt) { color: #e0e5ff; background: #1f2133; }
  .pane :global(.ibm) { color: #8a93bc; background: #1f2133; }
  .pane :global(.ibp) { color: #bb9af7; background: #1f2133; font-weight: 700; }
  .pane :global(.ibc) { color: #c0caf5; background: #1f2133; }
  .pane :global(.ibk) { color: #1f2133; background: #c0caf5; }

  /* ---- The walkthrough ---- */

  /* Under the window: the title and the controls, the steps in a row, then what happens now and
     where to read more. */
  .walk {
    --gap: 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'head ctl'
      'steps steps'
      'now links';
    gap: var(--gap) 24px;
    align-items: start;
    min-width: 0;
  }

  .walk-head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .walk-k {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .walk-k::before {
    content: '';
    width: 6px;
    height: 6px;
    background: currentColor;
    transform: rotate(45deg);
  }

  .walk-title {
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .walk-ctl {
    grid-area: ctl;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text-strong);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }

  .toggle:hover {
    border-color: var(--muted);
  }

  .toggle .i-play,
  .toggle[data-paused] .i-pause {
    display: none;
  }

  .toggle[data-paused] .i-play,
  .toggle .i-pause {
    display: inline-flex;
  }

  .pos {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .steps {
    grid-area: steps;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
  }

  .steps button {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    grid-template-areas:
      'n nm'
      'n what';
    column-gap: 10px;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 9px 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .steps button:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }

  .n {
    grid-area: n;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text);
  }

  .nm {
    grid-area: nm;
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.3;
    color: var(--text-strong);
  }

  .what {
    grid-area: what;
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .steps button[data-done] .n {
    border-color: rgba(158, 206, 106, 0.6);
    color: var(--green);
  }

  .steps button[aria-current] {
    border-color: rgba(255, 158, 100, 0.65);
    background: color-mix(in srgb, var(--orange) 8%, var(--surface));
    color: var(--text);
  }

  .steps button[aria-current] .n {
    border-color: var(--orange);
    background: var(--orange);
    color: var(--on-accent);
    font-weight: 700;
  }

  .now {
    grid-area: now;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 12px 16px 14px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--orange);
    border-radius: 10px;
    background: var(--well);
    overflow: hidden;
  }

  .now-k {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .caption {
    color: var(--text-strong);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* How far into the step it is. */
  .prog {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(255, 158, 100, 0.12);
  }

  .prog i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--orange);
    transition: width 0.4s ease;
  }

  .walk-links {
    grid-area: links;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 21rem;
    max-width: 100%;
  }

  .walk-cta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .walk-cta:hover {
    border-color: var(--blue);
  }

  .cta-t {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--blue);
    font-weight: 600;
  }

  .cta-d {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .walk-alt {
    align-self: flex-start;
    padding-left: 2px;
    font-size: 0.88rem;
  }

  /* Beside the window: a panel exactly as tall as the window, the steps as a list, and what happens
     now opened under the step that plays (the script moves it there). */
  .lay-side .walk {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--gap);
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background:
      radial-gradient(90% 40% at 0% 0%, rgba(255, 158, 100, 0.06), transparent 70%),
      var(--surface);
    contain: size;
    overflow: hidden;
  }

  .lay-side .walk-ctl {
    justify-content: space-between;
  }

  .lay-side .steps {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lay-side .steps li {
    border: 1px solid transparent;
    border-radius: 10px;
  }

  .lay-side .steps li.on {
    border-color: rgba(255, 158, 100, 0.55);
    background: color-mix(in srgb, var(--orange) 7%, var(--surface));
  }

  .lay-side .steps button {
    height: auto;
    padding: 5px 8px;
    border: 0;
    background: transparent;
  }

  .lay-side .steps button[aria-current] .what {
    display: none;
  }

  .lay-side .now {
    padding: 0 10px 12px 44px;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .lay-side .now-k {
    display: none;
  }

  .lay-side .caption {
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .lay-side .prog {
    left: 44px;
    right: 10px;
    bottom: 6px;
    border-radius: 2px;
  }

  .lay-side .walk-links {
    width: auto;
    margin-top: auto;
  }

  /* With room (the script says roomy), a step's name and what happens in it share a line. */
  .lay-side.roomy .steps button {
    grid-template-columns: 26px auto minmax(0, 1fr);
    grid-template-areas: 'n nm what';
  }

  /* A short window: the script adds d1 to d5, one at a time, until the panel fits, leaving out the
     least needed first. Past d5 it is let loose rather than cut. */
  .lay-side.d1 .walk-alt,
  .lay-side.d1 .cta-d,
  .lay-side.d2 .walk-title,
  .lay-side.d3 .steps button .what,
  .lay-side.d4 .walk-head {
    display: none;
  }

  .lay-side.d2 .walk {
    --gap: 10px;
    padding: 14px;
  }

  .lay-side.d2 .walk-cta {
    padding: 9px 12px;
  }

  .lay-side.d3 .walk {
    --gap: 8px;
    padding: 12px;
  }

  .lay-side.d3 .toggle {
    min-height: 34px;
  }

  .lay-side.d3 .steps button {
    grid-template-columns: 22px minmax(0, 1fr);
    grid-template-areas: 'n nm';
    padding: 3px 8px;
  }

  .lay-side.d3 .n {
    width: 22px;
    height: 22px;
  }

  .lay-side.d3 .now {
    padding-left: 38px;
  }

  .lay-side.d3 .prog {
    left: 38px;
  }

  .lay-side.d3 .caption {
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .lay-side.d5 .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .lay-side.d5 .steps li.on {
    grid-column: 1 / -1;
  }

  .lay-side.loose .walk {
    contain: none;
    overflow: visible;
  }

  /* Under the window on a short screen, the longer lines go. */
  @media (max-height: 820px) {
    .lay-split .cta-d {
      display: none;
    }
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .walk {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'ctl'
        'steps'
        'now'
        'links';
    }

    .walk-links {
      width: auto;
    }
  }

  @media (max-width: 420px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
