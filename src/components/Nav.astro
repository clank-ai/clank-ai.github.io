---
/**
 * The top bar on every page: the logo (home), the site's pages with the current one marked,
 * the docs (in the repository for now) and GitHub. On a phone the pages fold into a menu.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { LINKS, NAV, RELEASED } from '../config';

const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isHere = (href: string) => href !== '/' && (here === href || here.startsWith(href + '/'));
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label="Clank, home"><Logo height={24} label="Clank" /></a>

    <nav class="links" aria-label="Site">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isHere(item.href) ? 'page' : undefined} rel={item.external ? 'noopener' : undefined}>
                {item.label}
                {item.external && <span class="ext" aria-label="(on GitHub)">↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="right">
      {RELEASED && (
      <a class="gh" href={LINKS.github} aria-label="Clank on GitHub">
        <Icon name="github" size={17} />
        <span>GitHub</span>
      </a>
      )}
      <details class="menu" data-menu>
        <summary aria-label="Menu">
          <span class="bars" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <nav aria-label="Site, menu">
          <ul>
            <li><a href="/" aria-current={here === '/' ? 'page' : undefined}>Home</a></li>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>
                    {item.label}
                    {item.external && <span class="ext" aria-label="(on GitHub)">↗</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the phone menu once a page is picked, on Escape, or on a click outside it.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-menu]')) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
  // A hairline under the bar once the page has scrolled.
  const bar = document.querySelector<HTMLElement>('.nav');
  const onScroll = () => bar?.toggleAttribute('data-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(18, 18, 26, 0.78);
    backdrop-filter: saturate(150%) blur(14px);
    -webkit-backdrop-filter: saturate(150%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .nav[data-scrolled] {
    border-bottom-color: var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    padding: 8px 0;
    color: var(--text-strong);
    text-decoration: none;
  }

  .links {
    flex: 1;
    min-width: 0;
  }

  .links ul {
    display: flex;
    gap: 2px;
    list-style: none;
  }

  .links a,
  .menu a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.94rem;
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover,
  .menu a:hover {
    color: var(--text-strong);
    background: var(--surface);
  }

  .links a[aria-current='page'],
  .menu a[aria-current='page'] {
    color: var(--text-strong);
  }

  .links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: -12px;
    height: 2px;
    border-radius: 1px;
    background: var(--orange);
  }

  .ext {
    font-size: 0.8em;
    color: var(--faint);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 9px;
    color: var(--text-strong);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .gh:hover {
    border-color: var(--muted);
    color: var(--text-strong);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9px;
    border: 1px solid var(--line-strong);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .bars {
    display: grid;
    gap: 5px;
  }

  .bars i {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--text-strong);
    border-radius: 1px;
    transition: transform 0.2s ease;
  }

  .menu[open] .bars i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu[open] .bars i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(280px, calc(100vw - 32px));
    padding: 8px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 18px 50px -12px rgba(0, 0, 0, 0.6);
  }

  .menu ul {
    display: grid;
    list-style: none;
  }

  .menu a {
    display: flex;
    min-height: 44px;
  }

  .menu a[aria-current='page'] {
    background: var(--surface-2);
  }

  @media (max-width: 900px) {
    .links {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 400px) {
    .gh span {
      display: none;
    }

    .gh {
      width: 44px;
      height: 44px;
      padding: 0;
      justify-content: center;
    }
  }
</style>
