---
/**
 * Open source: Clank is meant to be forked, redesigned and rebuilt for each person's needs. The page
 * says so first, then shows why that is easy (the shape of its parts, the written reasons, the
 * tests), what can be built and where it lives, how to start, the repository, its principles, and
 * what it stands on. The license is one line, linked.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import CommandBlock from '../components/CommandBlock.astro';
import ForkGraph from '../components/oss/ForkGraph.astro';
import Blocks from '../components/oss/Blocks.astro';
import Extend from '../components/oss/Extend.astro';
import RepoTree from '../components/oss/RepoTree.astro';
import { LICENSE, LINKS, PAGES, repo } from '../config';

const easy = [
  {
    k: 'clank/components/',
    t: 'One shape for every part',
    d: 'Each component is a folder with the same files: its declaration, its records, its service, its routes, its commands, its pages and its adapters. Read one and you can find your way in any other.',
  },
  {
    k: 'tests/contract/',
    t: 'Adapters that plug in',
    d: 'Engines, cloud providers, agents, hosts and container platforms each sit behind one interface, held to one contract test on what the real program answered. One module adds one.',
  },
  {
    k: 'docs/decisions/',
    t: 'Every decision, with its reasons',
    d: 'More than a hundred decision records: what was chosen, why, and what it rules out. None is edited away; a later one supersedes it, so you can see what to change and what it will touch.',
  },
  {
    k: 'docs/design/',
    t: 'Designed, planned, then built',
    d: 'Each part has a design in numbered sections, each approved before it is built, and a plan for every step, task by task, in docs/plans/.',
  },
  {
    k: 'docs/TESTS.md',
    t: 'Tests first',
    d: 'A failing test comes before the code. Test names are sentences, and each test file names the design sections it holds to, so a change shows what it breaks.',
  },
  {
    k: 'AGENTS.md',
    t: 'Readable by your own model',
    d: 'AGENTS.md says where things are and the rules every change follows, for a person or a language model, a small local one included. Every module begins by saying what it does and why.',
  },
];

const steps = [
  {
    t: 'Fork it, and read AGENTS.md',
    d: 'Where things are, how work is recorded and the rules every change follows. Its read order goes from the principles to the design of the part you change.',
    link: [LINKS.agents, 'AGENTS.md'],
  },
  {
    t: 'Pick what to build',
    d: 'Your own need comes first. The roadmap also lists what is still to design: VS Code as the place of work (M6), network access (M7), tools and skills (M8) and the phone (M9).',
    link: [LINKS.roadmap, 'The roadmap'],
  },
  {
    t: 'Write down the why',
    d: 'A choice someone will later ask about gets a decision record, from the template. A design section is approved before it is built, and each step gets a plan.',
    link: [repo('docs/decisions/README.md'), 'The decision template'],
  },
  {
    t: 'Test first, then run every check',
    d: 'Write the failing test, then the code. One command formats, regenerates the generated documents and runs every check continuous integration runs.',
  },
  {
    t: 'Share it back, if you like',
    d: 'Small commits that each say what changed and why, then a pull request. Questions and ideas go in an issue.',
    link: [LINKS.issues, 'Issues on GitHub'],
  },
];

const principles = [
  ['Replace hosted assistants', 'A complete suite, so you can stop depending on hosted agents. Each feature is judged by whether it moves Clank toward that.'],
  ['Modular, plug and play', 'The model, the engine, the provider, sampling, tools and views each swap behind a small documented interface.'],
  ['Radical transparency', 'You can see everything Clank does and why, and change any of it, in readable files.'],
  ['Readable by people and by models', 'Small modules that say what they do and why, a code map, decision records, tests that say what they prove.'],
  ['Portable', 'Any local model and engine your hardware can run, an API key, or a model on another machine.'],
  ['The computer stays usable', 'No frozen desktop, no endless redraws, no surprise downloads or background load.'],
  ['Engineered as a product', 'Design before code, every decision recorded, a test for every behavior, small reviewed steps.'],
];

const builtOn = [
  ['OpenCode', 'the open-source coding agent Clank runs in each workspace', LINKS.opencode],
  ['llama.cpp', 'serves open models on your GPU, and is the base of KVMem', 'https://github.com/ggml-org/llama.cpp'],
  ['Docker', "the workspace's sandbox, one container per folder", 'https://www.docker.com'],
  ['Textual', 'the console, a terminal app', 'https://textual.textualize.io'],
  ['uv', "Python and Clank's dependencies, pinned", 'https://docs.astral.sh/uv/'],
];
---

<Base
  title="Open source · Clank"
  description="Clank is meant to be forked, redesigned and rebuilt for your own needs: every part in the same shape, every design and decision written down, and AGENTS.md so even your own local model can extend it."
  path={PAGES.openSource.path}
>
  <header class="oss-head">
    <div class="glow" aria-hidden="true"></div>
    <div class="container head-grid">
      <div class="head-text">
        <Breadcrumbs items={[{ label: 'Open source' }]} />
        <p class="eyebrow">Open source</p>
        <h1>Fork it and make it yours.</h1>
        <p class="lead">
          Clank is meant to be forked, redesigned and rebuilt for your own needs: your models, your tools, your workflow.
          It is built to make that easy. Every part has the same shape, every design and decision is written down with
          its reasons, and AGENTS.md is written so that even your own local model can extend it.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href={LINKS.fork}><Icon name="github" size={18} /> Fork on GitHub</a>
          <a class="btn btn-ghost" href={LINKS.agents}>Read AGENTS.md</a>
          <a class="btn btn-ghost" href={LINKS.roadmap}>The roadmap</a>
        </div>
        <p class="license">Free and open source under <a href={LINKS.license}>{LICENSE}</a>.</p>
      </div>
      <ForkGraph />
    </div>
  </header>

  <section class="section" aria-labelledby="easy-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Built to be changed</p>
        <h2 id="easy-title">Every part is written to be read, and to be replaced.</h2>
        <p class="lead">
          Clank is engineered so that someone who has never seen it, or their model, can find the part that matters,
          see why it is the way it is, and change it without breaking the rest.
        </p>
      </div>
      <ul class="easy">
        {
          easy.map((e) => (
            <li>
              <a class="k" href={repo(e.k)}>{e.k}</a>
              <h3>{e.t}</h3>
              <p>{e.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="blocks-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The building blocks</p>
        <h2 id="blocks-title">Clank's parts, and where yours fit.</h2>
        <p class="lead">
          Clients on top, components in the middle, the kernel underneath. Each component owns its kinds of adapter, so a
          new engine, provider or agent is one module beside the others, and a new part is one more component.
        </p>
      </div>
      <div class="blocks-gap">
        <Blocks />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="extend-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What you can build</p>
        <h2 id="extend-title">Places to start, and where they live.</h2>
        <p class="lead">
          Some are one module behind an interface that is already there; others are parts the roadmap leaves open. Each
          links to its place in the repository.
        </p>
      </div>
      <div class="legend" aria-hidden="true">
        <span class="lg adapter">an adapter beside the others</span>
        <span class="lg part">a change to a part</span>
        <span class="lg open">open on the roadmap</span>
      </div>
      <Extend />
    </div>
  </section>

  <section class="band" aria-labelledby="start-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Contributing</p>
        <h2 id="start-title">From your fork to your first change.</h2>
        <p class="lead">The same steps Clank itself is built with, from CONTRIBUTING.md and AGENTS.md.</p>
      </div>
      <div class="start">
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="sn" aria-hidden="true">{i + 1}</span>
                <div class="sb">
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                  {s.link && <a class="more" href={s.link[0]}>{s.link[1]}</a>}
                </div>
              </li>
            ))
          }
        </ol>
        <div class="start-side">
          <CommandBlock
            shell="Terminal"
            label="Clone your fork, set it up and run every check"
            lines={[
              'git clone https://github.com/your-name/clank',
              'cd clank',
              'uv sync',
              'uv run python -m tools.check --fix',
              'uv run clank console',
            ]}
          />
          <div class="model-card">
            <p class="mk">Your own model can help</p>
            <p>
              AGENTS.md is written for language models as well as people, in small files a model with a short context
              can load one at a time. Open your fork as a folder in Clank, and its agent can read the same rules you do.
            </p>
          </div>
          <p class="sec">A security problem? Read <a href={LINKS.security}>SECURITY.md</a> before opening an issue.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="repo-title">
    <div class="container repo-grid">
      <div class="repo-text">
        <p class="eyebrow">The repository</p>
        <h2 id="repo-title">The code, and the reasons beside it.</h2>
        <p class="lead">
          One repository holds the code, the tests, the VS Code extension, and every design, decision and plan. Start at
          AGENTS.md; the generated maps say where each module and each test is.
        </p>
        <a class="btn btn-ghost" href={LINKS.github}><Icon name="github" size={18} /> Browse the repository</a>
      </div>
      <RepoTree />
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Principles</p>
        <h2 id="principles-title">The rules every part follows.</h2>
        <p class="lead">A design or a change that breaks one of them must say so, and why, in a decision record.</p>
      </div>
      <ol class="principles">
        {
          principles.map(([t, d], i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t}</h3>
              <p>{d}</p>
            </li>
          ))
        }
      </ol>
      <p class="src"><a class="more" href={LINKS.principles}>The principles, in full</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="built-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Built on</p>
        <h2 id="built-title">Open source, standing on open source.</h2>
        <p class="lead">Clank brings these together and keeps each one swappable.</p>
      </div>
      <ul class="built">
        {
          builtOn.map(([name, what, href]) => (
            <li>
              <a href={href}>
                <b>{name}</b>
                <span>{what}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="end-title">
    <div class="container">
      <div class="end">
        <div>
          <h2 id="end-title">Your models, your tools, your workflow.</h2>
          <p>Fork Clank and build the version you need.</p>
        </div>
        <div class="end-ctas">
          <a class="btn btn-primary" href={LINKS.fork}><Icon name="github" size={18} /> Fork on GitHub</a>
          <a class="btn btn-ghost" href={LINKS.agents}>Read AGENTS.md</a>
          <a class="btn btn-ghost" href={LINKS.roadmap}>The roadmap</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The head: the invitation on the left, the fork on the right. */
  .oss-head {
    position: relative;
    isolation: isolate;
    padding-block: clamp(36px, 5vw, 64px) clamp(48px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(45% 80% at 85% 30%, rgba(158, 206, 106, 0.08), transparent 70%),
      radial-gradient(50% 90% at 10% 0%, rgba(122, 162, 247, 0.09), transparent 70%),
      linear-gradient(to right, rgba(122, 162, 247, 0.05) 1px, transparent 1px) 0 0 / 36px 72px,
      linear-gradient(to bottom, rgba(122, 162, 247, 0.05) 1px, transparent 1px) 0 0 / 36px 72px;
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent);
    mask-image: linear-gradient(to bottom, #000 50%, transparent);
  }

  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .head-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .head-text .eyebrow {
    margin-top: 14px;
  }

  h1 {
    font-size: clamp(2.375rem, 1.5rem + 3.4vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.032em;
  }

  .head-text .lead {
    max-width: 38rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--muted);
  }

  .ctas,
  .end-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ctas {
    margin-top: 6px;
  }

  .license {
    font-size: 0.92rem;
    color: var(--muted);
  }

  /* Built to be changed */
  .easy {
    margin-top: clamp(32px, 4vw, 48px);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
    overflow: hidden;
  }

  .easy li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 2.4vw, 28px);
    background: var(--bg);
  }

  .easy .k {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--orange);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .easy .k:hover {
    text-decoration: underline;
  }

  .easy h3 {
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .easy p {
    color: var(--muted);
    font-size: 0.96rem;
  }

  .blocks-gap {
    margin-top: clamp(32px, 4vw, 48px);
  }

  /* What you can build */
  .legend {
    margin: clamp(24px, 3vw, 36px) 0 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .lg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .lg::before {
    content: '';
    width: 14px;
    height: 10px;
    border-radius: 3px;
    border: 1.5px solid var(--c);
  }

  .lg.adapter {
    --c: var(--yellow);
  }

  .lg.part {
    --c: var(--orange);
  }

  .lg.open {
    --c: var(--green);
  }

  .lg.open::before {
    border-style: dashed;
  }

  /* Contributing */
  .start {
    margin-top: clamp(32px, 4vw, 48px);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .steps li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    padding-bottom: 26px;
    position: relative;
  }

  .steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 40px;
    bottom: 4px;
    border-left: 1px solid var(--line-strong);
  }

  .sn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--orange);
  }

  .sb {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding-top: 7px;
  }

  .sb h3 {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  .sb p {
    color: var(--muted);
  }

  .sb .more {
    min-height: 32px;
  }

  .start-side {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .model-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--green);
    border-radius: 12px;
    background: var(--surface);
  }

  .mk {
    font-weight: 600;
    color: var(--text-strong);
  }

  .model-card p:not(.mk) {
    color: var(--muted);
    font-size: 0.96rem;
  }

  .sec {
    font-size: 0.92rem;
    color: var(--muted);
  }

  /* The repository */
  .repo-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .repo-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .repo-text h2 {
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .repo-text .lead {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--muted);
  }

  /* Principles */
  .principles {
    margin-top: clamp(32px, 4vw, 48px);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* Each item draws its own right and bottom rule, so a row that is not full leaves plain ground. */
  .principles li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    box-shadow: 1px 1px 0 var(--line);
  }

  .n {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--orange);
  }

  .principles h3 {
    font-size: 1.1rem;
  }

  .principles p {
    color: var(--muted);
    font-size: 0.96rem;
  }

  .src {
    margin-top: 16px;
  }

  /* Built on */
  .built {
    margin-top: clamp(32px, 4vw, 48px);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 16px;
  }

  .built a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    color: var(--muted);
    text-decoration: none;
  }

  .built a:hover {
    border-color: var(--line-strong);
  }

  .built b {
    color: var(--text-strong);
    font-weight: 600;
  }

  .built b::after {
    content: ' ↗';
    color: var(--faint);
    font-weight: 400;
  }

  /* The last call */
  .end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(28px, 4.5vw, 52px);
    border: 1px solid rgba(158, 206, 106, 0.35);
    border-radius: 18px;
    background:
      radial-gradient(60% 120% at 100% 0%, rgba(158, 206, 106, 0.08), transparent 70%),
      var(--surface);
  }

  .end h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  .end p {
    margin-top: 8px;
    font-size: var(--fs-lead);
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .head-grid,
    .start,
    .repo-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .easy {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .easy {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .ctas .btn,
    .end-ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>
