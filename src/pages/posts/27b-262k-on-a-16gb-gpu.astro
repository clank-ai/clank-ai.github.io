---
/**
 * Post: Swift 1.5 (Qwen3.8-27B) with its whole 262K context on a 16 GB GPU, with KVMem and Clank. How I got here (a
 * short timeline: the dates from the repositories, the model cards and Clank's own records), what each piece is and
 * where it comes from, why it fits, what it did in a real session, what broke, and how to set it up, the literature
 * numbered in References (`REFS`, in the order the text first cites each; `<Cite>` links to them). Every number
 * comes from Clank's repository (docs/models/frontier-262k.md and the measurements it links), from the gateway's own
 * record of the session plotted (src/data/session-2026-10-20.json), or from the benchmark night's results
 * (src/data/bench-2026-10-27.json, exported by clank-bench's export.py; OpenCode alone against a flow is the site's
 * capture, src/data/captures/flows-vs-opencode.json). Figures are HTML and CSS; the session's chart is inline SVG.
 * Colors in charts are the validated categorical slots below, not the site's accents.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommandBlock from '../../components/CommandBlock.astro';
import Cite from '../../components/Cite.astro';
import { PAGES, LINKS, INSTALL } from '../../config';
import { POSTS, postPath } from '../../data/blog';
import session from '../../data/session-2026-10-20.json';
import overnight from '../../data/bench-2026-10-27.json';
import { comparison } from '../../data/captures';

const post = POSTS.find((p) => p.slug === '27b-262k-on-a-16gb-gpu')!;
const repo = LINKS.github;
const VIDEO = 'https://www.youtube.com/watch?v=h_KqS4GtU3I';
const KVMEM_REPO = 'https://github.com/kvmem/kvmem'; // kvmem/kvmem-llama.cpp until it was renamed
const FILE = 'Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf';
const REVISION = 'd74895bbe5db4bec1e0024e7cc87d59c02d7631a';
const SHA = '9aecf1cd41b2cb2f32a74e0d889e33855ebef43b26f43b43feb5720239e677e5';
const fmt = (n: number) => n.toLocaleString('en-US');

/* What runs where, top to bottom, and what passes between them. */
const pieces = [
  {
    where: 'Docker container, one per project',
    name: 'OpenCode',
    does: 'The coding agent. It reads and edits the project, runs commands, and sends every step to the model.',
    from: 'opencode.ai',
    href: 'https://opencode.ai',
    hop: 'each step, to localhost:18210',
  },
  {
    where: 'Windows 11',
    name: 'Clank',
    does: 'Checks the build and the file, starts the engine with the preset’s flags. Its gateway counts and logs each request.',
    from: 'clank-ai/clank',
    href: repo,
    hop: 'the same request, to localhost:18200',
  },
  {
    where: 'WSL 2, Ubuntu 22.04',
    name: 'KVMem server',
    does: 'Runs the model. A llama.cpp fork that keeps the whole KV cache in RAM and the part that matters on the GPU.',
    from: 'kvmem/kvmem, v0.16.0-rc1',
    href: KVMEM_REPO,
    hop: 'runs on',
  },
];

/* Layers 4, 8 … 64 attend fully (full_attention_interval = 4 in the file). */
const layers = Array.from({ length: 64 }, (_, i) => (i + 1) % 4 === 0);

/* KVMem: the whole context in RAM as blocks; the first block and the best matches go to the GPU. Not to scale. */
const blocks = Array.from({ length: 48 }, (_, i) => i === 0 || [5, 9, 10, 17, 23, 24, 31, 38, 41, 44, 46, 47].includes(i));

/* MiB of the card, as Clank estimates it and as nvidia-smi counts the card. */
const memory = [
  { label: 'Weights', mib: 11160, cls: 's1' },
  { label: 'KV cache', mib: 1728, cls: 's2' },
  { label: 'Buffers', mib: 1141, cls: 's3' },
  { label: 'KVMem', mib: 424, cls: 's4' },
  { label: 'Driver', mib: 326, cls: 'drv' },
  { label: 'Left for the desktop', mib: 1524, cls: 'free' },
];

/* Writing speed, tokens a second: [label, low, high]. */
const speeds: [string, number, number][] = [
  ['Quiet desktop, 8K–33K prompt', 74, 79],
  ['Agent session at 245K tokens', 57, 57],
  ['CPU busy, 8K to 237K', 33, 44],
  ['Desktop busy, 8K', 37, 37],
];

/* The session: tokens in the prompt, tokens read new, seconds to the first token, one row a step. */
const steps = (session as number[][]).map(([tokens, fresh, seconds], i) => ({ step: i + 1, tokens, fresh, seconds }));
const first = steps[0];
const tallest = steps.slice(1).reduce((a, b) => (b.seconds > a.seconds ? b : a));
const last = steps[steps.length - 1];
const X_MAX = 250000;
const Y_MAX = 16;
const yTicks = [0, 4, 8, 12, 16];
/* The chart twice: wide for a desktop, narrow for a phone, so its text stays readable on both. */
const charts = [
  { cls: 'wide', W: 640, H: 320, M: { l: 52, r: 18, t: 34, b: 48 }, xTicks: [0, 50000, 100000, 150000, 200000, 250000], notes: true },
  { cls: 'narrow', W: 360, H: 300, M: { l: 34, r: 14, t: 30, b: 46 }, xTicks: [0, 100000, 200000], notes: false },
].map((c) => ({
  ...c,
  px: (v: number) => c.M.l + (v / X_MAX) * (c.W - c.M.l - c.M.r),
  py: (v: number) => c.H - c.M.b - (v / Y_MAX) * (c.H - c.M.t - c.M.b),
}));

/* The benchmark night (src/data/bench-2026-10-27.json, exported from the harness's results): AIME 2026's first 15
   problems with frontier 262K as it ships, each answer's tokens against the cap, and the problems run so far with
   Python at hand. Then OpenCode alone against a flow on the problems both have done (the site's real capture). */
const CAP = 32768;
const aime = overnight.problems['swift-xhigh'].aime2026;
const withPython = new Map(overnight.problems['swift-xhigh-python'].aime2026.map((p) => [p.n, p]));
const aimeRight = aime.filter((p) => p.correct).length;
const aimeRow = overnight.rows.find((r) => r.config === 'swift-xhigh' && r.bench === 'aime2026')!;
const aimeMinutes = Math.round(aime.reduce((sum, p) => sum + p.seconds, 0) / 60);
const vs = comparison.sample ? null : comparison.data;
const vsMax = vs ? Math.max(...vs.rows.flatMap((r) => [r.opencode.minutes, r.flow.minutes])) : 1;
const problemOf = (id: string) => id.split('-').pop() ?? id;

const settings: [string, string, string][] = [
  ['-c', '262144', 'The model’s whole context.'],
  ['--kvmem-budget', '57344', 'Tokens attended exactly on the GPU.'],
  ['--kvmem-gen-reserve', '40960', 'The longest answer plus one step’s tool results. v0.16 fails an answer that outgrows it.'],
  ['--kv-dtype', 'q4_0', 'Half the size of q8_0, which would leave a window of about 23,800.'],
  ['-n', '32768', 'Room for long thinking and the answer.'],
  ['--spec-type', 'draft-mtp', 'The MTP head drafts 3 tokens a step.'],
  ['--enable-thinking', 'no budget', 'Effort stays at the template’s default, xhigh.'],
  ['GGML_CUDA_DISABLE_GRAPHS', '1', 'CUDA graphs crashed on a draft check.'],
];

const build = [
  'git clone --recurse-submodules https://github.com/kvmem/kvmem.git',
  'cd kvmem',
  'git checkout v0.16.0-rc1        # commit db4bc22, the version measured here',
  "git submodule update --init     # llama.cpp at KVMem's pin",
  'git cherry-pick -n 7e20823      # the long tool result fix, from v0.17.0',
  "scripts/apply-patches.sh        # KVMem's patch into llama.cpp",
  'scripts/build-cuda.sh           # CUDA 13.2; 120a-real is for RTX 50-series',
];

const withClank = [
  'clank serve --background',
  'clank host add ubuntu-22.04 --wsl Ubuntu-22.04',
  'clank engine adopt kvmem-llamacpp --version v0.16.0-rc1 --host ubuntu-22.04 --program <checkout>/build/bin/llama-kvmem-server --folder <checkout> --library-path <checkout>/build/bin',
  'clank model download swift-1.5-qwen3.8-27b --format gguf --host ubuntu-22.04',
  'clank preset check frontier-262k',
  'clank model switch frontier-262k',
];

const withoutClank = [
  'mkdir -p ~/models && cd ~/models',
  `wget -c https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-GGUF/resolve/${REVISION}/${FILE}`,
  `echo "${SHA}  ${FILE}" | sha256sum -c`,
  'cd ~/kvmem',
  `GGML_CUDA_DISABLE_GRAPHS=1 build/bin/llama-kvmem-server -m ~/models/${FILE} -c 262144 -n 32768 --kvmem-budget 57344 --kvmem-gen-reserve 40960 --kv-dtype q4_0 --spec-type draft-mtp --enable-thinking --host 127.0.0.1 --port 8080`,
];

const opencode = `{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kvmem": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KVMem",
      "options": { "baseURL": "http://127.0.0.1:8080/v1" },
      "models": {
        "MODEL_ID": {
          "name": "Swift 1.5, 262K",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 245760, "output": 32768 }
        }
      }
    }
  },
  "model": "kvmem/MODEL_ID"
}`;

/* The literature and the code, numbered in the order the text first cites them. */
const REFS: { key: string; href: string; who: string; title: string; where: string }[] = [
  { key: 'qwen', href: 'https://huggingface.co/Qwen/Qwen3.8-27B', who: 'Qwen Team (2026).', title: 'Qwen3.8-27B', where: 'Model card, Hugging Face, August 2026; the release: “Qwen3.8-Max: A New Bar for Coding and Cowork”, qwen.ai.' },
  { key: 'kvmem', href: 'https://arxiv.org/abs/2609.04852', who: 'D. Chai, L. Wang, Z. Su, Z. Xia and Z. Yu (2026).', title: 'KVMem: Virtualizing Million-Token Agent Workspaces on a Consumer GPU', where: 'arXiv:2609.04852.' },
  { key: 'kvmem-code', href: KVMEM_REPO, who: 'KVMem (2026).', title: 'kvmem/kvmem', where: 'GitHub, from September 14, 2026: v0.16.0-rc1, used here; v0.18.0 with NInfer as its backend, October 13, 2026.' },
  { key: 'ninfer', href: 'https://github.com/Neroued/ninfer', who: 'Neroued (2026).', title: 'NInfer: high-performance single-GPU inference', where: 'GitHub; its RTX 5080 fork with a 128K Qwen3.8-27B: github.com/toddballinger/ninfer-5080.' },
  { key: 'measured', href: `${repo}/blob/main/docs/measurements/2026-10-13-ninfer-and-kvmem.md`, who: 'Clank (2026).', title: 'NInfer and KVMem on this machine', where: 'Measurement, October 13, 2026, and the decision it led to (Clank’s decision 0034).' },
  { key: 'swift', href: 'https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-27b', who: 'UkisAI (2026).', title: 'Swift 1.5 Qwen3.8-27B', where: 'Model card, Hugging Face, September 24, 2026; its GGUF files with the MTP head: ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-GGUF.' },
  { key: 'video', href: VIDEO, who: 'Kai (2026).', title: 'How I Got Frontier Performance on 16GB VRAM (Qwen 3.8 27B)', where: 'YouTube, October 18, 2026.' },
  { key: 'gsq', href: 'https://arxiv.org/abs/2604.18556', who: 'A. Dadgarnia, S. Tabesh, M. Nikdan, M. Helcig, E. Kurtic, M. Kleinegger and D. Alistarh (2026).', title: 'GSQ: Highly-Accurate Low-Precision Scalar Quantization for LLMs via Gumbel-Softmax Sampling', where: 'arXiv:2604.18556.' },
  { key: 'rco', href: 'https://arxiv.org/abs/2605.00649', who: 'M. Helcig and D. Alistarh (2026).', title: 'Model Compression with Exact Budget Constraints via Riemannian Manifolds', where: 'arXiv:2605.00649.' },
  { key: 'mtp', href: 'https://arxiv.org/abs/2404.19737', who: 'F. Gloeckle, B. Youbi Idrissi, B. Rozière, D. Lopez-Paz and G. Synnaeve (2024).', title: 'Better & Faster Large Language Models via Multi-token Prediction', where: 'arXiv:2404.19737.' },
  { key: 'specdec', href: 'https://arxiv.org/abs/2211.17192', who: 'Y. Leviathan, M. Kalman and Y. Matias (2023).', title: 'Fast Inference from Transformers via Speculative Decoding', where: 'ICML 2023; arXiv:2211.17192.' },
  { key: 'gdn', href: 'https://arxiv.org/abs/2412.06464', who: 'S. Yang, J. Kautz and A. Hatamizadeh (2025).', title: 'Gated Delta Networks: Improving Mamba2 with Delta Rule', where: 'ICLR 2025; arXiv:2412.06464.' },
  { key: 'gattn', href: 'https://arxiv.org/abs/2505.06708', who: 'Z. Qiu, Z. Wang, B. Zheng et al. (2025).', title: 'Gated Attention for Large Language Models: Non-linearity, Sparsity, and Attention-Sink-Free', where: 'arXiv:2505.06708.' },
  { key: 'llamacpp', href: 'https://github.com/ggml-org/llama.cpp', who: 'ggml-org.', title: 'llama.cpp', where: 'GitHub: the engine KVMem builds on.' },
  { key: 'opencode', href: 'https://opencode.ai', who: 'OpenCode.', title: 'OpenCode', where: 'opencode.ai: the coding agent.' },
  { key: 'recipe', href: `${repo}/blob/main/docs/models/frontier-262k.md`, who: 'Clank (2026).', title: 'frontier 262K', where: 'The whole recipe, every setting and why, and its measurements (docs/measurements/2026-10-18-the-frontier-preset.md).' },
];
const cite = (...keys: string[]) => keys.map((key) => {
  const at = REFS.findIndex((r) => r.key === key);
  if (at < 0) throw new Error(`no reference ${key}`);
  return at + 1;
});

/* How I got here: each date from the repositories, the model cards, or Clank's own records. */
const timeline: { when: string; what: string; refs: string[] }[] = [
  { when: 'August', what: 'Trial and error with a few Qwen models. The one that stayed was Qwen3.8-27B, out in early August.', refs: ['qwen'] },
  { when: 'September 17', what: 'KVMem, three days after its code went up: most of the KV cache in system RAM, so the model kept a 262K-token context on 16 GB.', refs: ['kvmem', 'kvmem-code'] },
  { when: 'October 11–12', what: 'NInfer, in its RTX 5080 fork: about twice as fast at reading long prompts, but only 45K tokens of context fit beside my desktop.', refs: ['ninfer', 'measured'] },
  { when: 'October 11–13', what: 'Tried combining them: KVMem’s own builds with NInfer as the backend.', refs: ['kvmem-code'] },
  { when: 'October 13', what: 'Back to KVMem alone. On ten coding tasks both passed eight, but KVMem took 24 minutes to NInfer’s 43, with nearly six times the context.', refs: ['measured'] },
  { when: 'October 18', what: 'Swift 1.5, UkisAI’s fine-tune of Qwen3.8-27B (released September 24), after Kai’s video that day: it thinks about 42% less on average for the same GPQA Diamond score. It is what this post runs.', refs: ['swift', 'video'] },
];

/* The sections, for the contents list. */
const toc: [string, string][] = [
  ['history', 'How I got here'],
  ['pieces', 'The pieces'],
  ['file', 'The model file'],
  ['fit', 'Why 262K tokens fit'],
  ['session', 'In a real session'],
  ['benchmarks', 'How capable it is'],
  ['problems', 'What broke'],
  ['settings', 'The settings'],
  ['setup', 'Setup'],
  ['references', 'References'],
];
---

<Base title={`${post.title} · Clank`} description={post.dek} path={postPath(post)}>
  <div class="post-wrap">
  <nav class="toc" aria-label="On this page">
    <p class="toc-title">On this page</p>
    <ol>
      {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
    </ol>
  </nav>
  <article class="container post">
    <Breadcrumbs items={[{ label: 'Blog', href: PAGES.blog.path }, { label: 'This post' }]} />
    <h1>{post.title}</h1>
    <p class="dek">{post.dek}</p>
    <p class="byline">
      <span>{post.author}</span><span aria-hidden="true">·</span><time datetime={post.date}>{post.dateText}</time><span aria-hidden="true">·</span><span>{post.minutes} min read</span>{post.updated && <><span aria-hidden="true">·</span><span>Updated <time datetime={post.updated}>{post.updatedText}</time></span></>}
    </p>
    <dl class="stats">
      {post.stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>

    <p>
      This is the model I run every day for long agent sessions: Qwen3.8-27B in UkisAI’s Swift 1.5 fine-tune, with its
      full 262,144-token context, on one RTX 5080 with 16 GB.
    </p>
    <p>
      On 16 GB, memory is the limit: only about 57,000 tokens of exact context fit beside my desktop. KVMem moves most of
      the cache into system RAM, which takes it to 262,144, and Clank runs it all from one preset.
    </p>

    <h2 id="history">How I got here</h2>
    <ol class="timeline">
      {timeline.map((t) => (
        <li>
          <span class="when">{t.when}</span>
          <span class="what">{t.what}<Cite n={cite(...t.refs)} /></span>
        </li>
      ))}
    </ol>

    <h2 id="pieces">The pieces</h2>
    <figure class="fig">
      <ol class="chain">
        {pieces.map((p) => (
          <li>
            <div class="piece">
              <span class="where">{p.where}</span>
              <strong>{p.name}</strong>
              <span class="does">{p.does}</span>
              <a class="from" href={p.href}>{p.from}</a>
            </div>
            <p class="hop"><span class="arrow" aria-hidden="true">↓</span>{p.hop}</p>
          </li>
        ))}
      </ol>
      <div class="hw">
        <div class="piece">
          <span class="where">GPU</span>
          <strong>RTX 5080, 16 GB</strong>
          <span class="does">The weights, and up to 98,304 tokens of cache.</span>
        </div>
        <div class="piece">
          <span class="where">System RAM</span>
          <strong>64 GB</strong>
          <span class="does">The rest of the cache, up to 262,144 tokens.</span>
        </div>
      </div>
      <figcaption>All of it runs on one PC with a Ryzen 9 9950X3D. Nothing leaves it.</figcaption>
    </figure>

    <h2 id="file">The model file</h2>
    <figure class="fig">
      <ol class="lineage">
        <li class="card">
          <span class="who">Qwen</span>
          <strong>Qwen3.8-27B<Cite n={cite('qwen')} /></strong>
          <span>The base model: 27 billion parameters in 64 layers. Its reasoning effort defaults to xhigh.</span>
        </li>
        <li class="link" aria-hidden="true"><span>fine-tuned</span></li>
        <li class="card">
          <span class="who">UkisAI</span>
          <strong>Swift 1.5<Cite n={cite('swift')} /></strong>
          <span>Thinks about 42% less, on average, for the same GPQA Diamond score.</span>
        </li>
        <li class="link" aria-hidden="true"><span>compressed</span></li>
        <li class="card">
          <span class="who">ISTA-DASLab, refined by UkisAI</span>
          <strong>GSQ-RCO IQ3_S<Cite n={cite('gsq', 'rco')} /></strong>
          <span>About 3.5 bits a weight: one 12.1 GB file, with the MTP head that drafts tokens.<Cite n={cite('mtp', 'specdec')} /></span>
        </li>
      </ol>
      <figcaption>The file’s KL divergence from the full-precision model is 0.0513 (UkisAI’s measure).</figcaption>
    </figure>

    <h2 id="fit">Why 262K tokens fit</h2>
    <p>
      Most of the model’s layers keep no cache at all<Cite n={cite('gdn', 'gattn')} />, and most of the cache that remains
      lives in RAM<Cite n={cite('kvmem')} />.
    </p>

    <figure class="fig">
      <div class="layers" role="img" aria-label="64 layers: every fourth one, 16 in all, attends fully and keeps a KV cache; the other 48 keep a small fixed state.">
        {layers.map((full, i) => <span class={full ? 'full' : 'lin'} title={`Layer ${i + 1}: ${full ? 'full attention, KV cache' : 'linear attention, fixed state'}`} />)}
      </div>
      <ul class="legend">
        <li><span class="sw full" aria-hidden="true" />16 full-attention layers: they keep a KV cache</li>
        <li><span class="sw lin" aria-hidden="true" />48 linear-attention layers: a small fixed state</li>
      </ul>
      <figcaption>
        Every fourth layer is a gated attention layer that attends to the whole context; those 16 keep 18,432 bytes per
        token at q4_0. The other 48 are Gated DeltaNet layers, each with a small state of a fixed size.
      </figcaption>
    </figure>

    <figure class="fig">
      <p class="row-label">System RAM: the whole conversation, 262,144 tokens, in 128-token blocks</p>
      <div class="blocks" role="img" aria-label="The conversation in RAM as blocks; the first block and the blocks most like the latest message are highlighted.">
        {blocks.map((picked, i) => <span class={i === 0 ? 'first' : picked ? 'picked' : ''} />)}
      </div>
      <p class="copy"><span class="arrow" aria-hidden="true">↓</span>the first block, and the blocks most like your latest message</p>
      <p class="row-label">GPU: 98,304 cache cells</p>
      <div class="gpu" role="img" aria-label="The GPU's cache: the first block and the best-matching blocks, up to 57,344 tokens, then a reserve of 40,960 for new tokens.">
        <span class="exact">first block + best matches: 57,344</span>
        <span class="reserve">reserve: 40,960</span>
      </div>
      <figcaption>
        Up to 57,344 tokens, the whole conversation is on the GPU and attention is exact. The reserve holds what the model
        writes next and new tool results. Not to scale.
      </figcaption>
    </figure>

    <figure class="fig">
      <div class="mem" role="img" aria-label="Of the card's 16,303 MiB: weights 11,160, KV cache 1,728, buffers 1,141, KVMem 424, driver 326, and 1,524 left for the desktop.">
        {memory.map((m) => (
          <span class={m.cls} style={`flex-grow: ${m.mib}`} title={`${m.label}: ${fmt(m.mib)} MiB`}>
            {m.cls === 's1' && <b>Weights · 11,160 MiB</b>}
          </span>
        ))}
      </div>
      <ul class="legend">
        {memory.map((m) => <li><span class={`sw ${m.cls}`} aria-hidden="true" />{m.label} <span class="num">{fmt(m.mib)}</span></li>)}
      </ul>
      <figcaption>
        The card’s 16,303 MiB. The model takes 14,453 of it. If your desktop needs more than mine, the IQ3_XXS file is
        1.6 GB smaller.
      </figcaption>
    </figure>

    <h2 id="session">In a real session</h2>
    <p>
      An agent sends the whole conversation again at every step. KVMem keeps what it read the step before, so the model
      reads only what is new.
    </p>
    <figure class="fig">
      {charts.map((c) => (
        <svg class={`chart ${c.cls}`} viewBox={`0 0 ${c.W} ${c.H}`} role="img" aria-label={`Seconds to the first token at each of ${steps.length} steps, against the conversation's size: near one second from ${fmt(first.tokens)} to ${fmt(last.tokens)} tokens; the first step ${first.seconds} seconds; steps with a long tool result up to ${tallest.seconds}.`}>
          <text class="axis-title" x={c.M.l} y={16}>seconds to the first token</text>
          {yTicks.map((t) => (
            <g>
              <line class="grid" x1={c.M.l} x2={c.W - c.M.r} y1={c.py(t)} y2={c.py(t)} />
              <text class="tick" x={c.M.l - 8} y={c.py(t) + 4} text-anchor="end">{t}</text>
            </g>
          ))}
          {c.xTicks.map((t) => (
