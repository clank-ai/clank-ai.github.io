---
/**
 * Post: Swift 1.5 (Qwen3.8-27B) with its whole 262K context on a 16 GB GPU, with KVMem and Clank. What each piece is
 * and where it comes from, why it fits, what it did in a real session, what broke, and how to set it up. Every number
 * comes from Clank's repository (docs/models/frontier-262k.md and the measurements it links) or from the gateway's own
 * record of the session plotted (src/data/session-2026-10-20.json). Figures are HTML and CSS; the session's chart is
 * inline SVG. Colors in charts are the validated categorical slots below, not the site's accents.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommandBlock from '../../components/CommandBlock.astro';
import { PAGES, LINKS, INSTALL } from '../../config';
import { POSTS, postPath } from '../../data/blog';
import session from '../../data/session-2026-10-20.json';

const post = POSTS.find((p) => p.slug === '27b-262k-on-a-16gb-gpu')!;
const repo = LINKS.github;
const VIDEO = 'https://www.youtube.com/watch?v=h_KqS4GtU3I';
const KVMEM_REPO = 'https://github.com/kvmem/kvmem-llama.cpp';
const FILE = 'Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf';
const REVISION = 'd74895bbe5db4bec1e0024e7cc87d59c02d7631a';
const SHA = '9aecf1cd41b2cb2f32a74e0d889e33855ebef43b26f43b43feb5720239e677e5';
const fmt = (n: number) => n.toLocaleString('en-US');

/* What runs where, top to bottom, and what passes between them. */
const pieces = [
  {
    where: 'Docker container, one per project',
    name: 'OpenCode',
    does: 'The coding agent. It reads and edits the project, runs commands, and sends every step to the model.',
    from: 'opencode.ai',
    href: 'https://opencode.ai',
    hop: 'each step, to localhost:18210',
  },
  {
    where: 'Windows 11',
    name: 'Clank',
    does: 'Checks the build and the file, starts the engine with the preset’s flags. Its gateway counts and logs each request.',
    from: 'clank-ai/clank',
    href: repo,
    hop: 'the same request, to localhost:18200',
  },
  {
    where: 'WSL 2, Ubuntu 22.04',
    name: 'KVMem server',
    does: 'Runs the model. A llama.cpp fork that keeps the whole KV cache in RAM and the part that matters on the GPU.',
    from: 'kvmem/kvmem-llama.cpp, v0.16.0-rc1',
    href: KVMEM_REPO,
    hop: 'runs on',
  },
];

/* Layers 4, 8 … 64 attend fully (full_attention_interval = 4 in the file). */
const layers = Array.from({ length: 64 }, (_, i) => (i + 1) % 4 === 0);

/* KVMem: the whole context in RAM as blocks; the first block and the best matches go to the GPU. Not to scale. */
const blocks = Array.from({ length: 48 }, (_, i) => i === 0 || [5, 9, 10, 17, 23, 24, 31, 38, 41, 44, 46, 47].includes(i));

/* MiB of the card, as Clank estimates it and as nvidia-smi counts the card. */
const memory = [
  { label: 'Weights', mib: 11160, cls: 's1' },
  { label: 'KV cache', mib: 1728, cls: 's2' },
  { label: 'Buffers', mib: 1141, cls: 's3' },
  { label: 'KVMem', mib: 424, cls: 's4' },
  { label: 'Driver', mib: 326, cls: 'drv' },
  { label: 'Left for the desktop', mib: 1524, cls: 'free' },
];

/* Writing speed, tokens a second: [label, low, high]. */
const speeds: [string, number, number][] = [
  ['Quiet desktop, 8K–33K prompt', 74, 79],
  ['Agent session at 245K tokens', 57, 57],
  ['CPU busy, 8K to 237K', 33, 44],
  ['Desktop busy, 8K', 37, 37],
];

/* The session: tokens in the prompt, tokens read new, seconds to the first token, one row a step. */
const steps = (session as number[][]).map(([tokens, fresh, seconds], i) => ({ step: i + 1, tokens, fresh, seconds }));
const first = steps[0];
const tallest = steps.slice(1).reduce((a, b) => (b.seconds > a.seconds ? b : a));
const last = steps[steps.length - 1];
const X_MAX = 250000;
const Y_MAX = 16;
const yTicks = [0, 4, 8, 12, 16];
/* The chart twice: wide for a desktop, narrow for a phone, so its text stays readable on both. */
const charts = [
  { cls: 'wide', W: 640, H: 320, M: { l: 52, r: 18, t: 34, b: 48 }, xTicks: [0, 50000, 100000, 150000, 200000, 250000], notes: true },
  { cls: 'narrow', W: 360, H: 300, M: { l: 34, r: 14, t: 30, b: 46 }, xTicks: [0, 100000, 200000], notes: false },
].map((c) => ({
  ...c,
  px: (v: number) => c.M.l + (v / X_MAX) * (c.W - c.M.l - c.M.r),
  py: (v: number) => c.H - c.M.b - (v / Y_MAX) * (c.H - c.M.t - c.M.b),
}));

const settings: [string, string, string][] = [
  ['-c', '262144', 'The model’s whole context.'],
  ['--kvmem-budget', '57344', 'Tokens attended exactly on the GPU.'],
  ['--kvmem-gen-reserve', '40960', 'The longest answer plus one step’s tool results. v0.16 fails an answer that outgrows it.'],
  ['--kv-dtype', 'q4_0', 'Half the size of q8_0, which would leave a window of about 23,800.'],
  ['-n', '32768', 'Room for long thinking and the answer.'],
  ['--spec-type', 'draft-mtp', 'The MTP head drafts 3 tokens a step.'],
  ['--enable-thinking', 'no budget', 'Effort stays at the template’s default, xhigh.'],
  ['GGML_CUDA_DISABLE_GRAPHS', '1', 'CUDA graphs crashed on a draft check.'],
];

const build = [
  'git clone --recurse-submodules https://github.com/kvmem/kvmem-llama.cpp.git',
  'cd kvmem-llama.cpp',
  'git checkout v0.16.0-rc1        # commit db4bc22, the version measured here',
  "git submodule update --init     # llama.cpp at KVMem's pin",
  'git cherry-pick -n 7e20823      # the long tool result fix, from v0.17.0',
  "scripts/apply-patches.sh        # KVMem's patch into llama.cpp",
  'scripts/build-cuda.sh           # CUDA 13.2; 120a-real is for RTX 50-series',
];

const withClank = [
  'clank serve --background',
  'clank host add ubuntu-22.04 --wsl Ubuntu-22.04',
  'clank engine adopt kvmem-llamacpp --version v0.16.0-rc1 --host ubuntu-22.04 --program <checkout>/build/bin/llama-kvmem-server --folder <checkout> --library-path <checkout>/build/bin',
  'clank model download swift-1.5-qwen3.8-27b --format gguf --host ubuntu-22.04',
  'clank preset check frontier-262k',
  'clank model switch frontier-262k',
];

const withoutClank = [
  'mkdir -p ~/models && cd ~/models',
  `wget -c https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-GGUF/resolve/${REVISION}/${FILE}`,
  `echo "${SHA}  ${FILE}" | sha256sum -c`,
  'cd ~/kvmem-llama.cpp',
  `GGML_CUDA_DISABLE_GRAPHS=1 build/bin/llama-kvmem-server -m ~/models/${FILE} -c 262144 -n 32768 --kvmem-budget 57344 --kvmem-gen-reserve 40960 --kv-dtype q4_0 --spec-type draft-mtp --enable-thinking --host 127.0.0.1 --port 8080`,
];

const opencode = `{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kvmem": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KVMem",
      "options": { "baseURL": "http://127.0.0.1:8080/v1" },
      "models": {
        "MODEL_ID": {
          "name": "Swift 1.5, 262K",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 245760, "output": 32768 }
        }
      }
    }
  },
  "model": "kvmem/MODEL_ID"
}`;

const sources: [string, string, string][] = [
  ['https://huggingface.co/Qwen/Qwen3.8-27B', 'Qwen3.8-27B', 'the base model, by Qwen'],
  ['https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-27b', 'Swift 1.5', 'the fine-tune, by UkisAI'],
  ['https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-GGUF', 'The GGUF files', 'UkisAI’s, with the MTP head'],
  ['https://arxiv.org/abs/2604.18556', 'GSQ', 'and'],
  ['https://arxiv.org/abs/2605.00649', 'RCO', 'the quantization, by ISTA-DASLab'],
  ['https://arxiv.org/abs/2609.04852', 'KVMem’s paper', 'and'],
  [KVMEM_REPO, 'its code', 'the engine'],
  ['https://github.com/ggml-org/llama.cpp', 'llama.cpp', 'what KVMem builds on'],
  ['https://opencode.ai', 'OpenCode', 'the agent'],
  [`${repo}/blob/main/docs/models/frontier-262k.md`, 'The whole recipe', 'in Clank’s repository, with every setting and why'],
  [`${repo}/blob/main/docs/measurements/2026-10-18-the-frontier-preset.md`, 'The measurements', 'speed, memory and the long sessions'],
  [VIDEO, 'Kai’s video', 'the one that started it'],
];
---

<Base title={`${post.title} · Clank`} description={post.dek} path={postPath(post)}>
  <article class="container post">
    <Breadcrumbs items={[{ label: 'Blog', href: PAGES.blog.path }, { label: 'This post' }]} />
    <h1>{post.title}</h1>
    <p class="dek">{post.dek}</p>
    <p class="byline">
      <span>{post.author}</span><span aria-hidden="true">·</span><time datetime={post.date}>{post.dateText}</time><span aria-hidden="true">·</span><span>{post.minutes} min read</span>
    </p>

    <p>
      This is the model I run every day for long agent sessions: Qwen3.8-27B in UkisAI’s Swift 1.5 fine-tune, with its
      full 262,144-token context, on one RTX 5080 with 16 GB.
    </p>
    <p>
      It started with <a href={VIDEO}>Kai’s video</a> arguing that this model scores like a frontier model when its
      reasoning effort is left at the default. On 16 GB, memory was the limit: only about 57,000 tokens of context fit
      beside my desktop. KVMem moves most of the cache into system RAM, which took it to 262,144. Clank runs it all from
      one preset.
    </p>

    <h2 id="pieces">The pieces</h2>
    <figure class="fig">
      <ol class="chain">
        {pieces.map((p) => (
          <li>
            <div class="piece">
              <span class="where">{p.where}</span>
              <strong>{p.name}</strong>
              <span class="does">{p.does}</span>
              <a class="from" href={p.href}>{p.from}</a>
            </div>
            <p class="hop"><span class="arrow" aria-hidden="true">↓</span>{p.hop}</p>
          </li>
        ))}
      </ol>
      <div class="hw">
        <div class="piece">
          <span class="where">GPU</span>
          <strong>RTX 5080, 16 GB</strong>
          <span class="does">The weights, and up to 98,304 tokens of cache.</span>
        </div>
        <div class="piece">
          <span class="where">System RAM</span>
          <strong>64 GB</strong>
          <span class="does">The rest of the cache, up to 262,144 tokens.</span>
        </div>
      </div>
      <figcaption>All of it runs on one PC with a Ryzen 9 9950X3D. Nothing leaves it.</figcaption>
    </figure>

    <h2 id="file">The model file</h2>
    <figure class="fig">
      <ol class="lineage">
        <li class="card">
          <span class="who">Qwen</span>
          <strong>Qwen3.8-27B</strong>
          <span>The base model: 27 billion parameters in 64 layers. Its reasoning effort defaults to xhigh.</span>
        </li>
        <li class="link" aria-hidden="true"><span>fine-tuned</span></li>
        <li class="card">
          <span class="who">UkisAI</span>
          <strong>Swift 1.5</strong>
          <span>Thinks about 42% less for the same GPQA Diamond score.</span>
        </li>
        <li class="link" aria-hidden="true"><span>compressed</span></li>
        <li class="card">
          <span class="who">ISTA-DASLab, refined by UkisAI</span>
          <strong>GSQ-RCO IQ3_S</strong>
          <span>About 3.5 bits a weight: one 12.1 GB file, with the MTP head that drafts tokens.</span>
        </li>
      </ol>
      <figcaption>The file’s KL divergence from the full-precision model is 0.0513 (UkisAI’s measure).</figcaption>
    </figure>

    <h2 id="fit">Why 262K tokens fit</h2>
    <p>Most of the model’s layers keep no cache at all, and most of the cache that remains lives in RAM.</p>

    <figure class="fig">
      <div class="layers" role="img" aria-label="64 layers: every fourth one, 16 in all, attends fully and keeps a KV cache; the other 48 keep a small fixed state.">
        {layers.map((full, i) => <span class={full ? 'full' : 'lin'} title={`Layer ${i + 1}: ${full ? 'full attention, KV cache' : 'linear attention, fixed state'}`} />)}
      </div>
      <ul class="legend">
        <li><span class="sw full" aria-hidden="true" />16 full-attention layers: they keep a KV cache</li>
        <li><span class="sw lin" aria-hidden="true" />48 linear-attention layers: a small fixed state</li>
      </ul>
      <figcaption>Every fourth layer attends to the whole context. Those 16 keep 18,432 bytes per token at q4_0.</figcaption>
    </figure>

    <figure class="fig">
      <p class="row-label">System RAM: the whole conversation, 262,144 tokens, in 128-token blocks</p>
      <div class="blocks" role="img" aria-label="The conversation in RAM as blocks; the first block and the blocks most like the latest message are highlighted.">
        {blocks.map((picked, i) => <span class={i === 0 ? 'first' : picked ? 'picked' : ''} />)}
      </div>
      <p class="copy"><span class="arrow" aria-hidden="true">↓</span>the first block, and the blocks most like your latest message</p>
      <p class="row-label">GPU: 98,304 cache cells</p>
      <div class="gpu" role="img" aria-label="The GPU's cache: the first block and the best-matching blocks, up to 57,344 tokens, then a reserve of 40,960 for new tokens.">
        <span class="exact">first block + best matches: 57,344</span>
        <span class="reserve">reserve: 40,960</span>
      </div>
      <figcaption>
        Up to 57,344 tokens, the whole conversation is on the GPU and attention is exact. The reserve holds what the model
        writes next and new tool results. Not to scale.
      </figcaption>
    </figure>

    <figure class="fig">
      <div class="mem" role="img" aria-label="Of the card's 16,303 MiB: weights 11,160, KV cache 1,728, buffers 1,141, KVMem 424, driver 326, and 1,524 left for the desktop.">
        {memory.map((m) => (
          <span class={m.cls} style={`flex-grow: ${m.mib}`} title={`${m.label}: ${fmt(m.mib)} MiB`}>
            {m.cls === 's1' && <b>Weights · 11,160 MiB</b>}
          </span>
        ))}
      </div>
      <ul class="legend">
        {memory.map((m) => <li><span class={`sw ${m.cls}`} aria-hidden="true" />{m.label} <span class="num">{fmt(m.mib)}</span></li>)}
      </ul>
      <figcaption>
        The card’s 16,303 MiB. The model takes 14,453 of it. If your desktop needs more than mine, the IQ3_XXS file is
        1.6 GB smaller.
      </figcaption>
    </figure>

    <h2 id="session">In a real session</h2>
    <p>
      An agent sends the whole conversation again at every step. KVMem keeps what it read the step before, so the model
      reads only what is new.
    </p>
    <figure class="fig">
      {charts.map((c) => (
        <svg class={`chart ${c.cls}`} viewBox={`0 0 ${c.W} ${c.H}`} role="img" aria-label={`Seconds to the first token at each of ${steps.length} steps, against the conversation's size: near one second from ${fmt(first.tokens)} to ${fmt(last.tokens)} tokens; the first step ${first.seconds} seconds; steps with a long tool result up to ${tallest.seconds}.`}>
          <text class="axis-title" x={c.M.l} y={16}>seconds to the first token</text>
          {yTicks.map((t) => (
            <g>
              <line class="grid" x1={c.M.l} x2={c.W - c.M.r} y1={c.py(t)} y2={c.py(t)} />
              <text class="tick" x={c.M.l - 8} y={c.py(t) + 4} text-anchor="end">{t}</text>
            </g>
          ))}
          {c.xTicks.map((t) => (
            <text class="tick" x={c.px(t)} y={c.H - c.M.b + 20} text-anchor="middle">{t === 0 ? '0' : `${t / 1000}K`}</text>
          ))}
          <text class="axis-title" x={c.W - c.M.r} y={c.H - 6} text-anchor="end">tokens in the conversation</text>
          <line class="ref" x1={c.px(57344)} x2={c.px(57344)} y1={c.M.t} y2={c.H - c.M.b} />
          {steps.map((s) => (
            <circle class="dot" cx={c.px(s.tokens)} cy={c.py(s.seconds)} r={c.cls === 'wide' ? 4.5 : 3.5}>
              <title>{`Step ${s.step}: ${fmt(s.tokens)} tokens, ${fmt(s.fresh)} of them new, ${s.seconds} s`}</title>
            </circle>
          ))}
          {c.notes && (
            <g>
              <text class="note" x={c.px(57344) + 8} y={c.M.t + 12}>exact window ends</text>
              <text class="note" x={c.px(first.tokens) + 10} y={c.py(first.seconds) + 4}>first step</text>
              <text class="note" x={c.px(tallest.tokens) + 12} y={c.py(tallest.seconds) + 4}>a long tool result</text>
            </g>
          )}
        </svg>
      ))}
      <figcaption>
        One OpenCode session on October 20: {steps.length} steps over 67 minutes, from {fmt(first.tokens)} to
        {' '}{fmt(last.tokens)} tokens. The median step waited 1.4 seconds. The first step read all {fmt(first.tokens)}
        tokens; the line marks where the exact window ends.
      </figcaption>
      <details class="data">
        <summary>The {steps.length} steps</summary>
        <div class="table">
          <table>
            <thead><tr><th scope="col">Step</th><th scope="col">Tokens</th><th scope="col">New</th><th scope="col">Seconds</th></tr></thead>
            <tbody>{steps.map((s) => <tr><td>{s.step}</td><td>{fmt(s.tokens)}</td><td>{fmt(s.fresh)}</td><td>{s.seconds}</td></tr>)}</tbody>
          </table>
        </div>
      </details>
    </figure>
    <p>
      A new chat gets no such head start. Its first step reads OpenCode’s whole prompt, about 20,000 tokens: 12 seconds
      here, and up to 37 on a busy desktop.
    </p>

    <figure class="fig">
      <div class="speed">
        {speeds.map(([label, low, high]) => (
          <div class="srow" title={`${label}: ${low === high ? low : `${low}–${high}`} tokens a second`}>
            <span class="slabel">{label}</span>
            <span class="track">
              <span class="fill" style={`width: ${(low / 80) * 100}%`} />
              {high > low && <span class="span" style={`left: ${(low / 80) * 100}%; width: ${((high - low) / 80) * 100}%`} />}
            </span>
            <span class="sval">{low === high ? low : `${low}–${high}`}</span>
          </div>
        ))}
      </div>
      <figcaption>
        Writing speed, tokens a second. The MTP head drafts 3 tokens a step, and 81–87% are kept. Reading a prompt runs at
        about 1,500 tokens a second on a quiet desktop.
      </figcaption>
    </figure>

    <h2 id="problems">What broke</h2>
    <ul class="problems">
      <li>NVIDIA driver 617.42, installed by the NVIDIA app on its own, crashed KVMem on 2 of 9 cache clears. On 591.74, none in 66. Automatic driver updates are off now.</li>
      <li>When the card filled, Windows moved part of the model into RAM, and it crawled at 10 tokens a second. The Sysmem Fallback setting below prevents that.</li>
      <li>CUDA graphs crashed it three times during speculative decoding. They are off.</li>
      <li>A tool result bigger than the window failed with HTTP 500. KVMem fixed it in <code>7e20823</code>, which I picked onto v0.16.</li>
      <li>OpenCode compacted too late once, and KVMem refused a 246,931-token prompt. Clank now gives OpenCode the window less 16,384 tokens.</li>
      <li>A busy desktop or a video on the same card halves the speed.</li>
    </ul>

    <h2 id="settings">The settings</h2>
    <dl class="flags">
      {settings.map(([flag, value, why]) => (
        <div><dt><code>{flag}</code> <code class="val">{value}</code></dt><dd>{why}</dd></div>
      ))}
    </dl>

    <h2 id="setup">Setup</h2>
    <p>You need an NVIDIA card with 16 GB, Windows 11 with WSL 2, and about 6 GB of RAM free for WSL.</p>
    <h3>1. Windows</h3>
    <ol class="steps">
      <li>Install NVIDIA driver 591.74 (610.88 also worked), and turn off automatic driver updates in the NVIDIA app.</li>
      <li>NVIDIA Control Panel, Manage 3D settings: set CUDA Sysmem Fallback Policy to Prefer No Sysmem Fallback.</li>
      <li>Install Ubuntu 22.04 in WSL: <code>wsl --install -d Ubuntu-22.04</code>.</li>
      <li>In Ubuntu, install NVIDIA’s CUDA toolkit 13.2 for WSL-Ubuntu (no Linux driver: WSL uses the Windows one), then <code>sudo apt install build-essential cmake git</code>.</li>
    </ol>
    <h3>2. Build KVMem, in Ubuntu</h3>
    <CommandBlock shell="Ubuntu (WSL)" label="build KVMem" lines={build} />
    <p class="note">
      The cherry-pick stops at one conflict: take v0.17.0’s version and keep v0.16’s <code>fprintf</code> logging. Other
      cards need their own CUDA architecture.
    </p>
    <h3>3. Run it</h3>
    <div class="options">
      <section class="option">
        <h4>With Clank, in PowerShell</h4>
        <CommandBlock label="install Clank" lines={[INSTALL.windows]} />
        <p class="note">Then, in a new PowerShell window:</p>
        <CommandBlock label="load the model with Clank" lines={withClank} />
        <p class="note">
          <code>&lt;checkout&gt;</code> is the KVMem folder in Ubuntu. Clank checks the build, the file’s SHA-256 and
          whether it fits. Then open a terminal in your project, type <code>clank</code>, press <kbd>g</kbd> to set the
          folder up and <kbd>a</kbd> to start OpenCode.
        </p>
      </section>
      <section class="option">
        <h4>Without Clank, in Ubuntu</h4>
        <CommandBlock shell="Ubuntu (WSL)" label="download the model and start the server" lines={withoutClank} />
        <p class="note">Then point OpenCode at it in <code>~/.config/opencode/opencode.json</code>, with the id from <code>/v1/models</code> as <code>MODEL_ID</code>:</p>
        <pre class="json"><code set:text={opencode} /></pre>
        <p class="note">The context limit is 16,384 under 262,144 so OpenCode compacts before KVMem refuses.</p>
      </section>
    </div>

    <h2 id="sources">Where each piece comes from</h2>
    <ul class="sources">
      {sources.map(([href, label, what]) => <li><a href={href}>{label}</a> <span>{what}</span></li>)}
    </ul>
  </article>
</Base>

<style>
  .post {
    /* Validated categorical slots for the dark surface (dataviz palette): blue, orange, aqua, yellow. */
    --s1: #3987e5;
    --s2: #d95926;
    --s3: #199e70;
    --s4: #c98500;
    --neutral: #3b4261;
    --track: #262a3d;
    max-width: calc(46rem + 2 * var(--pad));
    padding-block: clamp(32px, 4vw, 48px) var(--section-gap);
    font-size: 1.125rem;
    line-height: 1.75;
  }
  .post > p,
  .post > ul,
  .post > ol,
  .post > h2,
  .post > h3,
  .post > .dek {
    max-width: 40rem;
  }
  h1 {
    margin-top: 20px;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3rem);
    line-height: 1.1;
    color: var(--text-strong);
