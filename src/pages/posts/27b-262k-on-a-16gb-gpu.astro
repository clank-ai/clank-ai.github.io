---
/**
 * Post: running Qwen3.8-27B (Swift 1.5) with a 262K context on a 16 GB GPU with KVMem and Clank.
 * Every number comes from Clank's repository (docs/models/frontier-262k.md and the measurements it
 * links), and the video's claims from the check made on 2026-10-18. Diagrams are plain HTML and CSS.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommandBlock from '../../components/CommandBlock.astro';
import { PAGES, LINKS, INSTALL } from '../../config';
import { POSTS, postPath } from '../../data/blog';

const post = POSTS.find((p) => p.slug === '27b-262k-on-a-16gb-gpu')!;
const repo = LINKS.github;
const VIDEO = 'https://www.youtube.com/watch?v=h_KqS4GtU3I';
const KVMEM_PAPER = 'https://arxiv.org/abs/2609.04852';
const KVMEM_REPO = 'https://github.com/kvmem/kvmem';
const FILE = 'Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp.gguf';
const REVISION = 'd74895bbe5db4bec1e0024e7cc87d59c02d7631a';
const SHA = '9aecf1cd41b2cb2f32a74e0d889e33855ebef43b26f43b43feb5720239e677e5';

const ram = [1, 0, 0, 2, 0, 0, 0, 0, 2, 2, 0, 0, 0, 0, 2, 0, 0, 0, 0, 0, 2, 0, 0, 0, 2, 2, 0, 0, 0, 2, 2, 2];

const memory = [
  { label: 'Weights', mib: 11160, cls: 'w' },
  { label: 'KV cache', mib: 1728, cls: 'kv' },
  { label: 'Buffers', mib: 1141, cls: 'buf' },
  { label: 'KVMem', mib: 424, cls: 'kvm' },
  { label: 'Driver', mib: 326, cls: 'drv' },
  { label: 'Desktop and headroom', mib: 1524, cls: 'free' },
];

const speeds = [
  { label: 'Idle desktop, 8K–33K', value: '74–79', pct: 100, cls: 'good' },
  { label: 'Agent session, 245K', value: '57', pct: 72, cls: 'good' },
  { label: 'CPU loaded, 8K–237K', value: '33–44', pct: 55, cls: 'mid' },
  { label: 'Desktop busy, 8K', value: '37', pct: 46, cls: 'bad' },
];

const settings = [
  ['-c', '262144', "The model's full context"],
  ['--kvmem-budget', '57344', 'Exact window on the GPU'],
  ['--kvmem-gen-reserve', '40960', 'The longest answer (32,768) plus one step’s tool results. v0.16 fails an answer that outgrows it.'],
  ['--kv-dtype', 'q4_0', 'At q8_0 the exact window would shrink to about 23,800'],
  ['-n', '32768', 'Room for long thinking plus the answer'],
  ['--enable-thinking', 'no budget', 'Effort stays at the template’s xhigh; a thinking budget would cut it off'],
  ['--spec-type', 'draft-mtp', 'Speculative decoding with the model’s own MTP head, 3 drafts per step'],
  ['CUDA graphs', 'off', 'Crashed three times on a speculative verify step'],
  ['sampling', 't 1.0, p 0.95, k 20', 'KVMem’s defaults for this model; not tuned yet'],
];

const build = [
  'git clone --recurse-submodules https://github.com/kvmem/kvmem.git kvmem-llama.cpp',
  'cd kvmem-llama.cpp',
  'git checkout v0.16.0-rc1        # commit db4bc22, the version measured here',
  "git submodule update --init     # llama.cpp at KVMem's pin",
  'git cherry-pick -n 7e20823      # the large-tool-result fix (in v0.17.0 and later)',
  "scripts/apply-patches.sh        # KVMem's patch into the llama.cpp submodule",
  'scripts/build-cuda.sh           # CUDA 13.2, 120a-real for RTX 50-series',
];

const installClank = [INSTALL.windows];
const withClank = [
  'clank serve --background',
  'clank host add ubuntu-22.04 --wsl Ubuntu-22.04',
  'clank engine adopt kvmem-llamacpp --version v0.16.0-rc1 --host ubuntu-22.04 --program <checkout>/build/bin/llama-kvmem-server --folder <checkout> --library-path <checkout>/build/bin',
  'clank model download swift-1.5-qwen3.8-27b --format gguf --host ubuntu-22.04',
  'clank preset check frontier-262k',
  'clank model switch frontier-262k',
];

const download = [
  'mkdir -p ~/models && cd ~/models',
  `wget -c https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-GGUF/resolve/${REVISION}/${FILE}`,
  `echo "${SHA}  ${FILE}" | sha256sum -c`,
];

const serve = [
  'cd ~/kvmem-llama.cpp',
  `GGML_CUDA_DISABLE_GRAPHS=1 build/bin/llama-kvmem-server -m ~/models/${FILE} -c 262144 -n 32768 --kvmem-budget 57344 --kvmem-gen-reserve 40960 --kv-dtype q4_0 --spec-type draft-mtp --enable-thinking --host 127.0.0.1 --port 8080`,
];

const test = [
  'curl -s http://127.0.0.1:8080/health',
  'curl -s http://127.0.0.1:8080/v1/models',
  `curl -s http://127.0.0.1:8080/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"MODEL_ID","max_tokens":256,"messages":[{"role":"user","content":"Hello"}]}'`,
];

const opencode = `{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kvmem": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KVMem",
      "options": { "baseURL": "http://127.0.0.1:8080/v1" },
      "models": {
        "MODEL_ID": {
          "name": "Swift 1.5, 262K",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 245760, "output": 32768 }
        }
      }
    }
  },
  "model": "kvmem/MODEL_ID"
}`;

type Verdict = 'Accurate' | 'Mostly accurate' | 'Misleading' | 'Wrong as captioned';
const verdictClass: Record<Verdict, string> = {
  Accurate: 'v-ok',
  'Mostly accurate': 'v-most',
  Misleading: 'v-mis',
  'Wrong as captioned': 'v-wrong',
};
const claims: [string, string, Verdict, string][] = [
  ['C01', 'Qwen beats Opus 4.6 Max on LiveCodeBench and SWE-bench Pro by "not small gaps"', 'Mostly accurate', 'Numbers are on Qwen’s card. The 1.5-point LiveCodeBench gap is within run-to-run spread; the SWE-bench Pro comparison is not like for like.'],
  ['C02', 'Another video’s "86.6, beats Opus 4.8" is a copy-paste error; there is no Opus 4.8', 'Misleading', 'Opus 4.8 exists (May 28, 2026). 86.6 is Qwen’s figure for Qwen3.8-Max.'],
  ['C03', 'Artificial Analysis: xhigh 34, medium 28, low 26, thinking off 20', 'Accurate', 'AA’s values: 33.68, 27.55, 26.20, 20.15.'],
  ['C04', 'At xhigh Qwen beats Opus 4.6 Max, GPT-5.3 Codex and Gemini 3.1 Pro; at medium it loses to all three', 'Mostly accurate', 'True on AA’s index, but two of the three scores are AA estimates.'],
  ['C05', 'The "52 on AA" came from an older index', 'Accurate', '52.02 on v4.1.1, 34 on v4.3. It was outdated, not wrong.'],
  ['C06', 'The top model on AA is Claude Opus 5.5 at 58', 'Accurate', '57.62, at its Max setting.'],
  ['C07', 'AA runs its own 10-test suite', 'Mostly accurate', '10 tests run by AA; AA built 3 of them. The summary skips coding and a knowledge test, 35% of the weight.'],
  ['C08', 'Effort is three values, a line of prompt text, default xhigh', 'Accurate', 'Matches the chat template. Note: llama.cpp’s web UI effort menu is a token cap instead.'],
  ['C09', 'An xhigh Pac-Man run thought 40,000 tokens before writing code', 'Mostly accurate', '40K was the post’s top figure, not a typical one; "before writing code" was added.'],
  ['C10', 'ARC Prize saw medium cost more than low and score less', 'Accurate', 'ARC offered the template as a possible explanation, not a finding.'],
  ['C11', 'AA’s GPQA Diamond: 88.28 / 84.14 / 84.04', 'Wrong as captioned', 'Those are UkisAI’s numbers; AA has 90.51 / 84.55 / 84.55. Likely a caption error.'],
  ['C12', '~15,000 thinking tokens per GPQA question, ~5.5 min at 45.6 tok/s', 'Accurate', 'It is a mean; the median is 6,642.'],
  ['C13', 'A Terminal-Bench task takes 28 min at xhigh, under a minute at medium', 'Misleading', 'Medium thinks ~30,000 tokens on the same tasks, about 16–24 min.'],
  ['C14', 'A 5060 Ti at 45–46 tok/s beats the 41.3 tok/s hosted median', 'Misleading', '41.3 is Alibaba’s endpoint; the middle AA provider ran ~145.'],
  ['C15', 'The build is 11.77 GB; with MTP 12.12 GB', 'Mostly accurate', 'Two different files; the recommended one is 12.12 GB.'],
  ['C16', 'Popular 16 GB setups set medium effort', 'Accurate', 'Both cited posts do.'],
  ['C17', 'Another video capped thinking at 512 tokens, ~3% of what is needed', 'Mostly accurate', 'It ran Swift 1.5 (mean 8,717), so 512 is ~5.9%.'],
  ['C18', 'The benchmarks used a 500K window', 'Misleading', 'No source says 500K; the stated window is 256K.'],
  ['C19', 'About 110,000 tokens of q8_0 cache fit', 'Mostly accurate', '~93–95K with MTP on an empty card; ~57K beside a desktop.'],
  ['C20', 'The other video’s 50K context ran out mid-task', 'Accurate', 'Its log shows truncation at 50,176 tokens.'],
  ['C21', 'Swift 1.5 thinks 42% less on GPQA (15,014 → 8,717) at 88.59%', 'Mostly accurate', 'Matches UkisAI’s card; the quantization is ISTA-DASLab’s.'],
  ['C22', '58.5% is the best case; 1.95x and 9.18x come from two tables', 'Mostly accurate', 'The conflict is between two cards, not two tables.'],
  ['C23', 'Aider: base 77.6%, Swift 75.7%, in half the time', 'Accurate', 'That was Swift 1.0 at Q8_0 on Apple Silicon.'],
  ['C24', '~5,000 tasks on 4×3090: low and xhigh tied at 89.3%', 'Mostly accurate', 'The tie is one of five inference stacks.'],
  ['C25', 'VulcanBench: xhigh "slightly" worse', 'Mostly accurate', '8.7 points worse, the report’s headline.'],
  ['C26', 'Benjamin Marie: xhigh is most accurate on harder tasks', 'Accurate', 'It also wrote 2.7× medium’s tokens.'],
  ['C27', 'Run the IQ3_S-mtp file, 12.12 GB, UkisAI’s license', 'Accurate', 'The license allows commercial use only under US$1M revenue.'],
  ['C28', 'The desktop holds 1–2 GB of VRAM; skip the vision projector', 'Mostly accurate', 'True on my PC, far less on others; the recommended repo has no projector.'],
  ['C29', 'MTP gives ~45 tok/s instead of 30-something', 'Mostly accurate', 'Without MTP those cards run in the high 20s; some users see no gain.'],
  ['C30', 'RX 9070 XT: 43.7 tok/s at 65K, 37.4 at 131K', 'Mostly accurate', 'Measured with MTP off, on Vulkan.'],
  ['C31', 'Hosted Qwen3.8-27B costs $2.20 per million output tokens', 'Mostly accurate', 'One provider’s price; the range is $0.50–$3.20.'],
  ['C32', 'Leaving effort unset runs xhigh, as the benchmarks did', 'Accurate', 'Same template in the GGUF files; Qwen’s own tables do not state their effort.'],
];
const tally = (v: Verdict) => claims.filter((c) => c[2] === v).length;
const verdicts: Verdict[] = ['Accurate', 'Mostly accurate', 'Misleading', 'Wrong as captioned'];

const links = [
  [VIDEO, 'Kai: How I Got Frontier Performance on 16GB VRAM (Qwen 3.8 27B)'],
  [KVMEM_PAPER, 'KVMem: Virtualizing Million-Token Agent Workspaces on a Consumer GPU (arXiv:2609.04852)'],
  [KVMEM_REPO, 'KVMem on GitHub'],
  ['https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-27b', 'Swift 1.5 model card (UkisAI)'],
  ['https://huggingface.co/ukisai/Swift-1.5-Qwen3.8-27B-GSQ-RCO-GGUF', 'Swift 1.5 GSQ-RCO GGUF files'],
  ['https://arxiv.org/abs/2604.18556', 'GSQ (arXiv:2604.18556), ISTA-DASLab'],
  ['https://arxiv.org/abs/2605.00649', 'RCO (arXiv:2605.00649), ISTA-DASLab'],
  ['https://huggingface.co/Qwen/Qwen3.8-27B', 'Qwen3.8-27B'],
  [`${repo}/blob/main/docs/models/frontier-262k.md`, 'The full recipe in Clank’s repository'],
  [`${repo}/blob/main/docs/measurements/2026-10-18-the-frontier-preset.md`, 'Measurements, October 18'],
  [`${repo}/blob/main/docs/measurements/2026-10-15-kvmem-long-tool-results.md`, 'KVMem and long tool results'],
  [`${repo}/blob/main/docs/measurements/2026-10-14-the-nvidia-driver.md`, 'The driver measurement'],
];
---

<Base title={`${post.title} · Clank`} description={post.dek} path={postPath(post)}>
  <article class="container post">
    <Breadcrumbs items={[{ label: 'Blog', href: PAGES.blog.path }, { label: 'This post' }]} />
    <h1>{post.title}</h1>
    <p class="dek">{post.dek}</p>
    <p class="byline">
      <span>{post.author}</span><span aria-hidden="true">·</span><time datetime={post.date}>{post.dateText}</time><span aria-hidden="true">·</span><span>{post.minutes} min read</span>
    </p>

    <p>
      On October 18 I watched Kai’s video <a href={VIDEO}>How I Got Frontier Performance on 16GB VRAM (Qwen 3.8 27B)</a>.
      Its argument: Qwen3.8-27B scores like a February frontier model if you leave its reasoning effort at the default,
      xhigh, and the Swift 1.5 fine-tune gets most of that score with far less thinking. I checked all 32 of its claims
      before copying anything (results at the end). Then I built the setup into Clank and pushed the context from about
      57K to 262K with KVMem. It has been my main model for long agent sessions since.
    </p>

    <dl class="stats">
      {post.stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>

    <h2 id="stack">The stack</h2>
    <p>
      Each box runs inside the one around it. OpenCode sends requests to Clank’s gateway, which forwards them to the KVMem
      server in WSL; KVMem loads the model file onto the GPU.
    </p>
    <figure class="stack">
      <div class="box pc">
        <div class="head"><strong>Windows 11 PC</strong><span>RTX 5080 16 GB · Ryzen 9 9950X3D · 64 GB RAM</span></div>
        <div class="pair">
          <div class="box clankbox">
            <div class="head"><strong>Docker</strong></div>
            <div class="box inner2">
              <strong>OpenCode</strong>
              <p>The coding agent, in the project’s container.</p>
            </div>
          </div>
          <div class="box clankbox">
            <div class="head"><strong>Clank</strong></div>
            <p>Service: adopts and checks the KVMem build, starts it with the preset’s flags.</p>
            <p>Gateway (port 18210): receives OpenCode’s requests, counts tokens, logs each request.</p>
          </div>
        </div>
        <div class="box wsl">
          <div class="head"><strong>WSL 2 · Ubuntu 22.04</strong><span>CUDA toolkit 13.2, the Windows driver</span></div>
          <div class="box kvmem">
            <div class="head"><strong>KVMem server, port 18200</strong><span>llama.cpp fork, v0.16.0-rc1 + one fix</span></div>
            <p>Keeps the KV cache for the exact window on the GPU and the rest in system RAM.</p>
            <div class="box file">
              <div class="head"><strong>Model file · GSQ-RCO IQ3_S, 12.1 GB</strong><span>quantization by ISTA-DASLab, packaged by UkisAI</span></div>
              <div class="box weights">
                <div class="head"><strong>Weights · Swift 1.5</strong><span>fine-tune by UkisAI</span></div>
                <div class="box arch">
                  <div class="head"><strong>Architecture · Qwen3.8-27B</strong><span>Qwen</span></div>
                  <p>64 layers (16 full attention), MTP head</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <figcaption>Requests: OpenCode → gateway :18210 → KVMem :18200. Memory: weights and the exact window on the GPU, older context in system RAM.</figcaption>
    </figure>

    <h2 id="kv-cache">KV cache</h2>
    <p>
      Qwen3.8-27B has 64 layers, but only 16 of them use full attention. The other 48 are linear-attention layers with a
      small fixed-size state. Only the 16 full-attention layers keep a KV cache, so a token costs 18,432 bytes of cache at
      <code>q4_0</code>. If all 64 layers kept a cache it would be four times as much.
    </p>
    <figure class="layers" role="img" aria-label="Of 64 layers, 48 are linear attention with a fixed state and 16 are full attention with a KV cache.">
      <div class="bar">
        <div class="lin">48 linear-attention layers · fixed state, no KV cache</div>
        <div class="full">16 full · KV cache</div>
      </div>
      <figcaption>Counts, not positions.</figcaption>
    </figure>

    <h2 id="kvmem">KVMem</h2>
    <p>
      KVMem (<a href={KVMEM_PAPER}>paper</a>, <a href={KVMEM_REPO}>repo</a>) keeps the full KV history in system RAM and
      gives the GPU a fixed working set. Up to 57,344 tokens, attention is exact. Past that, the GPU holds the first 128
      tokens plus the blocks that best match the latest user message, and the rest stays in RAM. A separate 40,960-token
      reserve holds the tokens the model writes and new tool results.
    </p>
    <figure class="kvmem-fig" role="img" aria-label="The whole 262,144-token context sits in system RAM as blocks. The GPU holds 98,304 cells: the first 128 tokens and the best-matching blocks, up to 57,344 tokens, plus a 40,960-token reserve for new tokens.">
      <div class="row-label"><span>System RAM: the whole context, 262,144 tokens</span><span>marked: blocks matching the latest message</span></div>
      <div class="blocks">{ram.map((b) => <span class={b === 1 ? 'sink' : b === 2 ? 'pick' : ''} />)}</div>
      <div class="down" aria-hidden="true">↓</div>
      <div class="row-label"><span>GPU: 98,304 cache cells</span></div>
      <div class="gpu">
        <div class="sink">first</div>
        <div class="exact">exact window: 57,344</div>
        <div class="reserve">reserve for new tokens: 40,960</div>
      </div>
      <figcaption>Block sizes and positions are not to scale.</figcaption>
    </figure>
    <p>
      KVMem also caches the prompt prefix. In an agent session each step resends the whole conversation plus a little
      more. In four long sessions (up to 250+ steps and 245,411 tokens), about 99% of each prompt came from KVMem’s cache,
      so a step only processes what is new.
    </p>

    <h2 id="memory">GPU memory</h2>
    <figure class="mem" role="img" aria-label="Of 16,303 MiB: weights 11,160; KV cache 1,728; buffers 1,141; KVMem overhead 424; driver reserve 326; 1,524 left for the desktop and headroom.">
      <div class="bar">{memory.map((m) => <div class={m.cls} style={`flex: ${m.mib}`} />)}</div>
      <ul class="legend">{memory.map((m) => <li><span class={`sw ${m.cls}`} aria-hidden="true" />{m.label} {m.mib.toLocaleString('en-US')}</li>)}</ul>
    </figure>
    <p>
      The model takes 14,453 MiB of the card’s 16,303. With my desktop on the same card, total use was 15,753 MiB. If your
      desktop needs more, the IQ3_XXS file from the same repository is 1.6 GB smaller (KL divergence 0.0978 instead of
      0.0513).
    </p>

    <h2 id="speed">Speed</h2>
    <figure class="speed" role="img" aria-label="Generation speed in tokens per second: idle desktop 74 to 79; long agent session 57; CPU loaded 33 to 44; desktop busy 37.">
      {speeds.map((s) => (
        <div class="srow">
          <span>{s.label}</span>
          <div class="track"><div class={`fill ${s.cls}`} style={`width: ${s.pct}%`} /><b>{s.value}</b></div>
        </div>
      ))}
      <figcaption>
        Generation, tokens per second. Prompt processing: 1,520–1,601 tok/s idle, 981–576 with the CPU loaded, 492 with
        the desktop busy. MTP drafts 3 tokens per step; 81–87% are accepted.
      </figcaption>
    </figure>

    <h2 id="settings">Settings</h2>
    <dl class="settings">
      {settings.map(([f, v, w]) => (
        <div>
          <dt><code class="flag">{f}</code> <code class="val">{v}</code></dt>
          <dd>{w}</dd>
        </div>
      ))}
    </dl>

    <h2 id="problems">Problems</h2>
    <ul class="problems">
      <li><b>A driver update.</b> The NVIDIA app installed 617.42 on its own on October 13. KVMem then crashed with CUDA errors on 2 of 9 cache clears. Back on 591.74: 0 of 66. Automatic driver updates are off now.</li>
      <li><b>Windows moving the model to RAM.</b> When the card filled, generation fell to 10 tok/s until a restart. Fix: NVIDIA Control Panel → Manage 3D settings → CUDA Sysmem Fallback Policy → Prefer No Sysmem Fallback.</li>
      <li><b>CUDA graphs.</b> Three crashes on October 8 during speculative decoding. Disabled with <code>GGML_CUDA_DISABLE_GRAPHS=1</code>.</li>
      <li><b>A large tool result.</b> One tool output bigger than the exact window failed the request with HTTP 500. Fixed upstream in commit <code>7e20823</code>, which I cherry-picked onto v0.16.</li>
      <li><b>Late compaction.</b> OpenCode sent 246,931 tokens plus 16,384 for the answer, over the limit, and KVMem refused. Clank now tells OpenCode the window minus a 16K margin and turns the refusal into an overflow error OpenCode compacts on.</li>
      <li><b>A shared card.</b> A busy desktop or a video on the same GPU halves generation speed.</li>
      <li><b>Recall past the window.</b> At about 220,000 tokens it passed 5 of 6 retrieval probes. The miss was a rule from the system prompt.</li>
    </ul>

    <h2 id="setup">Setup</h2>
    <p>
      Two options: with Clank, which adopts and checks the build, or with only KVMem and the model file. The first two
      steps are the same for both.
    </p>
    <h3>1. Windows</h3>
    <ol class="steps">
      <li>Install NVIDIA driver <b>591.74</b> (610.88 also worked; 617.42 crashed KVMem). Turn off automatic driver updates in the NVIDIA app.</li>
      <li>NVIDIA Control Panel → Manage 3D settings → <b>CUDA Sysmem Fallback Policy: Prefer No Sysmem Fallback</b>.</li>
      <li>Install WSL 2 with Ubuntu 22.04: <code>wsl --install -d Ubuntu-22.04</code>. Leave about 6 GB of RAM free for it.</li>
      <li>In Ubuntu, install the <b>CUDA toolkit 13.2 for WSL-Ubuntu</b> from NVIDIA’s download page. Do not install a Linux driver; WSL uses the Windows one. Then <code>sudo apt install build-essential cmake git</code>.</li>
    </ol>
    <h3>2. Build KVMem</h3>
    <CommandBlock shell="Ubuntu (WSL)" label="build KVMem" lines={build} />
    <p class="note">
      The cherry-pick stops at one conflict; resolve it to v0.17.0’s version, keeping v0.16’s <code>fprintf</code>
      logging. Other cards need their own CUDA architecture instead of <code>120a-real</code>. Newer KVMem releases
      include the fix but may change flags; the flags here are for v0.16.0-rc1.
    </p>

    <div class="options">
      <section class="option">
        <h3>3A. With Clank</h3>
        <p class="note">Clank checks the build, the file’s SHA-256 and whether the preset fits, then runs it and serves OpenCode. Install it in PowerShell; the installer gets uv, Git and Docker Desktop if they are missing, asking first:</p>
        <CommandBlock label="install Clank" lines={installClank} />
        <p class="note">Then, in a new PowerShell:</p>
        <CommandBlock label="set up Clank with KVMem and Swift 1.5" lines={withClank} />
        <p class="note">
          <code>&lt;checkout&gt;</code> is the KVMem folder inside Ubuntu. Then open a terminal in your project, type
          <code>clank</code>, press <kbd>g</kbd> to finish the folder’s setup and <kbd>a</kbd> to start OpenCode.
        </p>
      </section>
      <section class="option">
        <h3>3B. KVMem and the model only</h3>
        <p class="note">No Clank; everything in Ubuntu. Download and check the model:</p>
        <CommandBlock shell="Ubuntu (WSL)" label="download and check the model" lines={download} />
        <p class="note">Start the server:</p>
        <CommandBlock shell="Ubuntu (WSL)" label="start the KVMem server" lines={serve} />
        <p class="note">Check it answers:</p>
        <CommandBlock shell="Ubuntu (WSL)" label="test the server" lines={test} />
        <p class="note">Point OpenCode at it, in <code>~/.config/opencode/opencode.json</code>:</p>
        <pre class="json"><code set:text={opencode} /></pre>
        <p class="note">
          Use the id from <code>/v1/models</code> as <code>MODEL_ID</code>. The context limit is 16,384 under 262,144 on
          purpose, so OpenCode compacts before KVMem refuses the request.
        </p>
      </section>
    </div>

    <h2 id="video">Fact-checking the video</h2>
    <p>
      Before copying the setup I checked the video’s claims against their sources: Qwen’s model card and chat template,
      Artificial Analysis, UkisAI’s cards and report, ARC Prize, the Reddit and X posts it cites, and archived copies of
      each. 32 claims, five of them checked twice by an independent second pass; both passes agreed on all five. The check
      was done on October 18.
    </p>
    <figure class="verdicts" role="img" aria-label={`Of 32 claims: ${tally('Accurate')} accurate, ${tally('Mostly accurate')} mostly accurate, ${tally('Misleading')} misleading, ${tally('Wrong as captioned')} wrong as captioned.`}>
      <div class="bar">{verdicts.map((v) => <div class={verdictClass[v]} style={`flex: ${tally(v)}`}>{tally(v)}</div>)}</div>
      <ul class="legend">{verdicts.map((v) => <li><span class={`sw ${verdictClass[v]}`} aria-hidden="true" />{v}</li>)}</ul>
    </figure>

    <h3>Correct</h3>
    <p>
      Qwen’s chat template defaults to xhigh. The effort setting is a line of text in the system prompt, not a token cap,
      and medium adds no instruction at all. Artificial Analysis scores the same weights 34 at xhigh and 28 at medium,
      which puts xhigh above the three February frontier models the video names and medium below all three. So in my
      setup the effort is left unset (xhigh) and thinking has no budget.
    </p>
    <h3>Incorrect or misleading</h3>
    <ul class="problems">
      <li>"There is no Opus 4.8" is false: Anthropic released it on May 28, 2026. The 86.6 on Terminal-Bench 2.1 the video calls a copy-paste error is Qwen’s published score for a different model, Qwen3.8-Max.</li>
      <li>The "median hosted speed" of 41.3 tok/s is Alibaba’s own endpoint, one of the slowest. The middle provider ran about 145 tok/s.</li>
      <li>No source gives the 500K-token window the benchmarks supposedly used. The only stated window is 256K.</li>
      <li>"28 minutes per task at xhigh, under a minute at medium" compares an agent task with a chat prompt. On the same tasks medium thinks about 30,000 tokens, roughly 16–24 minutes.</li>
      <li>"About 110,000 tokens at q8_0" ignores buffers and the MTP cache: about 93–95K with MTP on an empty card, about 57K next to my desktop. This is the number that sent me to KVMem.</li>
      <li>The GSQ-RCO quantization is ISTA-DASLab’s (<a href="https://arxiv.org/abs/2604.18556">GSQ</a>, <a href="https://arxiv.org/abs/2605.00649">RCO</a>); UkisAI packaged it for Swift.</li>
    </ul>

    <details class="claims">
      <summary>All 32 claims</summary>
      <div class="table">
        <table>
          <thead><tr><th scope="col">#</th><th scope="col">Claim</th><th scope="col">Verdict</th><th scope="col">What the sources say</th></tr></thead>
          <tbody>
            {claims.map(([id, claim, verdict, note]) => (
              <tr><td><code>{id}</code></td><td>{claim}</td><td class={`verdict ${verdictClass[verdict]}`}>{verdict}</td><td>{note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
    <p class="note">
      Not checkable: the video it debunks at 03:51, the source of Opus 4.6’s 53.4 on SWE-bench Pro, how UkisAI computed
      1.95x, and the audio at 08:18, which could not be fetched.
    </p>

    <h2 id="next">Next</h2>
    <p>
      This model now runs Clank’s flows, which work through long multi-step tasks on their own. The next posts cover a
      benchmark for those flows and the search for a faster second model to run beside this one.
    </p>

