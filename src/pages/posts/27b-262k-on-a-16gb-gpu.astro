<script>
  /* The contents list marks the section in view. */
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [a.hash.slice(1), a] as const),
  );
  const shown = new Set<string>();
  const mark = () => {
    const first = [...links.keys()].find((id) => shown.has(id));
    for (const [id, a] of links) a.toggleAttribute('aria-current', id === first);
  };
  const watch = new IntersectionObserver(
    (entries) => {
      for (const e of entries) (e.isIntersecting ? shown.add(e.target.id) : shown.delete(e.target.id));
      mark();
    },
    { rootMargin: '-80px 0px -55% 0px' },
  );
  for (const id of links.keys()) {
    const target = document.getElementById(id);
    if (target) watch.observe(target);
  }
</script>

