---
/** The page Cloudflare Pages serves for an address that does not exist. */
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Clank" path="/404" noindex>
  <section class="container nf">
    <p class="code">404</p>
    <h1>This page does not exist.</h1>
    <p>The address may be mistyped, or the page may have moved.</p>
    <a class="btn btn-primary" href="/">Go to Clank's home page</a>
  </section>
</Base>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding-block: clamp(80px, 14vw, 160px);
  }

  .code {
    font-family: var(--font-mono);
    color: var(--orange);
    letter-spacing: 0.14em;
  }

  h1 {
    font-size: var(--fs-h2);
    letter-spacing: -0.02em;
  }

  p {
    color: var(--muted);
  }
</style>
